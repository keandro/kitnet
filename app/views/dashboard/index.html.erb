<% content_for :title, "Dashboard" %>

<h1 class="text-2xl font-semibold text-slate-900 dark:text-white">Dashboard</h1>
<p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Visão geral da sua operação hoje, <%= l(Date.current, format: :long) %>.</p>

<div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
  <%= render "shared/stat_tile", label: "Pessoas cadastradas", value: @total_pessoas, icon_name: :users, tone: :primary %>
  <%= render "shared/stat_tile", label: "Unidades ocupadas", value: "#{@unidades_por_status["ocupada"].to_i}/#{@total_unidades}", icon_name: :building, tone: :info %>
  <%= render "shared/stat_tile", label: "Contratos ativos", value: @contratos_ativos, icon_name: :document, tone: :good %>
  <%= render "shared/stat_tile", label: "Pagamentos vencidos", value: @pagamentos_vencidos.size, icon_name: :cash, tone: :critical, sublabel: (@pagamentos_vencidos.any? ? "#{number_to_currency(@valor_vencido)} em aberto" : nil) %>
</div>

<div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-5">
  <div class="rounded-xl border border-slate-200 bg-white p-5 dark:border-white/10 dark:bg-slate-800/40 lg:col-span-2">
    <h2 class="text-sm font-medium text-slate-900 dark:text-white">Ocupação das unidades</h2>

    <% total = @total_unidades.zero? ? 1 : @total_unidades %>
    <% livres = @unidades_por_status["livre"].to_i %>
    <% ocupadas = @unidades_por_status["ocupada"].to_i %>
    <% manutencao = @unidades_por_status["manutencao"].to_i %>

    <% if @total_unidades.zero? %>
      <p class="mt-4 text-sm text-slate-500 dark:text-slate-400">Nenhuma unidade cadastrada ainda.</p>
    <% else %>
      <div class="mt-4 flex h-3 w-full gap-0.5 overflow-hidden rounded-full bg-slate-100 dark:bg-white/5">
        <% if ocupadas > 0 %><div class="bg-blue-500" style="width: <%= (ocupadas.to_f / total * 100).round(2) %>%"></div><% end %>
        <% if livres > 0 %><div class="bg-emerald-500" style="width: <%= (livres.to_f / total * 100).round(2) %>%"></div><% end %>
        <% if manutencao > 0 %><div class="bg-amber-500" style="width: <%= (manutencao.to_f / total * 100).round(2) %>%"></div><% end %>
      </div>

      <ul class="mt-4 space-y-2 text-sm">
        <li class="flex items-center justify-between">
          <span class="flex items-center gap-2 text-slate-600 dark:text-slate-300"><span class="size-2.5 rounded-full bg-blue-500"></span>Ocupadas</span>
          <span class="font-medium text-slate-900 dark:text-white"><%= ocupadas %></span>
        </li>
        <li class="flex items-center justify-between">
          <span class="flex items-center gap-2 text-slate-600 dark:text-slate-300"><span class="size-2.5 rounded-full bg-emerald-500"></span>Livres</span>
          <span class="font-medium text-slate-900 dark:text-white"><%= livres %></span>
        </li>
        <li class="flex items-center justify-between">
          <span class="flex items-center gap-2 text-slate-600 dark:text-slate-300"><span class="size-2.5 rounded-full bg-amber-500"></span>Em manutenção</span>
          <span class="font-medium text-slate-900 dark:text-white"><%= manutencao %></span>
        </li>
      </ul>
    <% end %>

    <%= link_to "Ver unidades", unidades_path, class: "mt-4 inline-block text-sm font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400" %>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-5 dark:border-white/10 dark:bg-slate-800/40 lg:col-span-3">
    <div class="flex items-center justify-between">
      <h2 class="text-sm font-medium text-slate-900 dark:text-white">Próximos pagamentos</h2>
      <%= link_to "Ver contratos", contratos_path, class: "text-sm font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400" %>
    </div>

    <% if @proximos_pagamentos.empty? %>
      <p class="mt-4 text-sm text-slate-500 dark:text-slate-400">Nenhum pagamento pendente ou vencido. Tudo em dia.</p>
    <% else %>
      <ul class="mt-4 divide-y divide-slate-100 dark:divide-white/5">
        <% @proximos_pagamentos.each do |pagamento| %>
          <li class="flex items-center justify-between gap-4 py-3">
            <div class="min-w-0">
              <%= link_to pagamento.contrato.morador.nome, pagamento.contrato, class: "text-sm font-medium text-slate-900 hover:text-indigo-600 dark:text-white dark:hover:text-indigo-400" %>
              <p class="text-xs text-slate-500 dark:text-slate-400"><%= pagamento.contrato.unidade.nome %> · vence em <%= l(pagamento.data_vencimento) %></p>
            </div>
            <div class="flex shrink-0 items-center gap-3">
              <span class="text-sm font-medium text-slate-900 dark:text-white"><%= number_to_currency(pagamento.valor) %></span>
              <%= status_pagamento_badge(pagamento.status) %>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</div>
