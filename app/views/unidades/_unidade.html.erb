<div id="<%= dom_id unidade %>" class="rounded-xl border border-slate-200 bg-white dark:border-white/10 dark:bg-slate-800/40">
  <div class="flex items-center gap-4 border-b border-slate-200 p-6 dark:border-white/10">
    <span class="flex size-12 shrink-0 items-center justify-center rounded-full bg-indigo-50 text-indigo-700 dark:bg-indigo-400/10 dark:text-indigo-400">
      <%= icon :building, css_class: "size-6" %>
    </span>
    <div>
      <h2 class="text-lg font-semibold text-slate-900 dark:text-white"><%= unidade.nome %></h2>
      <div class="mt-1"><%= unidade_status_badge(unidade.status) %></div>
    </div>
  </div>

  <dl class="grid grid-cols-1 gap-x-6 gap-y-5 p-6 sm:grid-cols-2">
    <div>
      <dt class="text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">Endereço</dt>
      <dd class="mt-1 text-sm text-slate-900 dark:text-white"><%= unidade.endereco.presence || "—" %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">Valor base</dt>
      <dd class="mt-1 text-sm text-slate-900 dark:text-white"><%= unidade.valor_base ? number_to_currency(unidade.valor_base) : "—" %></dd>
    </div>
  </dl>
</div>
