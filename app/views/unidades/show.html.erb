<% content_for :title, "Kitnet #{@unidade.nome}" %>

<%= link_to unidades_path, class: "inline-flex items-center gap-1 text-sm font-medium text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-white" do %>
  <%= icon :arrow_left, css_class: "size-4" %> Kitnets
<% end %>

<div class="mt-4 flex flex-wrap items-center justify-between gap-4">
  <div class="flex items-center gap-3">
    <h1 class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-white">Kitnet <%= @unidade.nome %></h1>
    <%= status_badge("Descontinuada", tone: :neutral, icon: :clock) if @unidade.descontinuada? %>
  </div>
  <div class="flex flex-wrap gap-2">
    <%= link_to new_pagamento_path(unidade_id: @unidade.id), class: "btn btn-primary" do %>
      <%= icon :plus, css_class: "size-4" %> Registrar pagamento
    <% end %>
    <%= link_to edit_unidade_path(@unidade), class: "btn btn-secondary" do %>
      <%= icon :pencil, css_class: "size-4" %> Editar
    <% end %>
  </div>
</div>

<dl class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
  <% [ [ "Valor base", @unidade.valor_base ? number_to_currency(@unidade.valor_base) : "—" ],
       [ "Dia do pagamento", @unidade.dia_pagamento ? "Dia #{@unidade.dia_pagamento}" : "—" ],
       [ "Pagamentos registrados", @pagamentos.size ],
       [ "Total recebido", number_to_currency(@pagamentos.sum(&:valor)) ] ].each do |rotulo, valor| %>
    <div class="card p-5">
      <dt class="text-sm text-slate-500 dark:text-slate-400"><%= rotulo %></dt>
      <dd class="mt-1 text-xl font-semibold tabular-nums text-slate-900 dark:text-white"><%= valor %></dd>
    </div>
  <% end %>
</dl>

<section class="card mt-6 overflow-hidden">
  <div class="border-b border-slate-100 px-5 py-4 dark:border-white/5">
    <h2 class="text-sm font-medium text-slate-900 dark:text-white">Pagamentos</h2>
  </div>
  <% if @pagamentos.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-100 dark:divide-white/5">
        <%= render "pagamentos/table_head", mostrar_kitnet: false %>
        <tbody class="divide-y divide-slate-100 dark:divide-white/5">
          <%= render partial: "pagamentos/pagamento_row", collection: @pagamentos, as: :pagamento, locals: { mostrar_kitnet: false } %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="px-4 py-12 text-center">
      <%= icon :cash, css_class: "mx-auto size-8 text-slate-300 dark:text-slate-600" %>
      <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">Nenhum pagamento registrado.</p>
    </div>
  <% end %>
</section>
