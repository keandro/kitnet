<div class="card p-6">
  <%= render "shared/error_summary", object: unidade %>

  <%= form_with(model: unidade, html: { autocomplete: "off" }) do |form| %>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      <div>
        <%= form.label :valor_base, class: label_classes %>
        <%= money_field form, :valor_base %>
      </div>

      <div>
        <%= form.label :dia_pagamento, "Dia do pagamento", class: label_classes %>
        <%= form.number_field :dia_pagamento, in: 1..31, inputmode: "numeric", class: field_classes(unidade, :dia_pagamento) %>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Vem como data do pagamento ao lançar um pagamento desta kitnet.</p>
      </div>
    </div>

    <div class="mt-6 flex items-center justify-end gap-3 border-t border-slate-100 pt-5 dark:border-white/5">
      <%= link_to "Cancelar", unidade, class: "btn btn-secondary" %>
      <%= form.submit "Salvar", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
