<% content_for :title, "Kitnets" %>

<h1 class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-white">Kitnets</h1>

<% @grupos.each do |titulo, unidades| %>
  <div class="mt-8">
    <h2 class="text-[11px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400"><%= titulo %></h2>

    <div class="mt-3 grid grid-cols-2 gap-3 sm:gap-4 sm:grid-cols-4">
      <% unidades.each do |unidade| %>
        <% paga = @pagas_no_mes.include?(unidade.id) %>
        <%# O cartão inteiro abre a kitnet (link por baixo); o lápis edita o valor base e o dia ali mesmo. %>
        <div class="card group relative p-4 transition hover:-translate-y-0.5 hover:shadow-md hover:ring-indigo-200 sm:p-5 dark:hover:ring-indigo-400/30"
             data-controller="edicao-rapida" data-action="keydown.esc->edicao-rapida#cancelar">
          <%= link_to "", unidade, class: "absolute inset-0 rounded-2xl", aria: { label: "Abrir kitnet #{unidade.nome}" } %>
          <div class="pointer-events-none relative flex flex-wrap items-center justify-between gap-x-2 gap-y-1.5">
            <span class="<%= unidade.nome.size > 4 ? "text-lg" : "text-2xl" %> font-semibold tracking-tight text-slate-900 dark:text-white"><%= unidade.nome %></span>
            <% if unidade.descontinuada? %>
              <%= status_badge("Antiga", tone: :neutral, icon: :clock) %>
            <% elsif @vazias_no_mes.include?(unidade.id) %>
              <%= status_badge("Vazia", tone: :neutral) %>
            <% elsif paga %>
              <%= status_badge("Pago", tone: :good) %>
            <% elsif unidade.valor_base %>
              <%= status_badge("Em aberto", tone: :warning, icon: :clock) %>
            <% end %>
          </div>

          <div class="relative mt-3 flex items-center justify-between gap-2" data-edicao-rapida-target="exibicao">
            <div class="pointer-events-none min-w-0">
              <p class="text-sm font-medium tabular-nums <%= unidade.valor_base ? "text-slate-900 dark:text-white" : "text-slate-400 dark:text-slate-500" %>"><%= unidade.valor_base ? number_to_currency(unidade.valor_base) : "Sem valor base" %></p>
              <% if unidade.dia_pagamento %>
                <p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">Paga no dia <%= unidade.dia_pagamento %></p>
              <% end %>
            </div>
            <button type="button" data-action="edicao-rapida#editar" title="Editar valor base e dia" aria-label="Editar valor base e dia do pagamento da kitnet <%= unidade.nome %>"
                    class="acao acao-azul acao-icone -my-1">
              <%= icon :pencil, css_class: "size-4" %>
            </button>
          </div>

          <%= form_with model: unidade, html: { autocomplete: "off" }, class: "relative mt-3 hidden", data: { edicao_rapida_target: "formulario" } do |form| %>
            <%= hidden_field_tag :retorno, "kitnets" %>
            <%= form.label :valor_base, "Valor base da kitnet #{unidade.nome}", class: "sr-only" %>
            <%= money_field form, :valor_base, data: { edicao_rapida_target: "campo" } %>
            <div class="mt-2 flex items-center gap-2">
              <%= form.label :dia_pagamento, "Dia", class: "shrink-0 text-xs font-medium text-slate-600 dark:text-slate-300" %>
              <%= form.number_field :dia_pagamento, in: 1..31, inputmode: "numeric",
                    class: field_classes(unidade, :dia_pagamento).sub("mt-1.5 ", "").sub("py-2", "py-1.5"), aria: { label: "Dia do pagamento da kitnet #{unidade.nome}" } %>
            </div>
            <div class="mt-2 flex flex-wrap gap-2">
              <%= form.submit "Salvar", class: "btn btn-primary flex-1 px-2 py-1.5 text-xs" %>
              <button type="button" data-action="edicao-rapida#cancelar" class="btn btn-secondary flex-1 px-2 py-1.5 text-xs">Cancelar</button>
            </div>
          <% end %>

          <% if unidade.descontinuada? %>
            <p class="pointer-events-none relative mt-0.5 text-xs text-slate-500 dark:text-slate-400"><%= pluralize(unidade.pagamentos.size, "pagamento", plural: "pagamentos") %> no histórico</p>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
