<div id="<%= dom_id contrato %>" class="rounded-xl border border-slate-200 bg-white dark:border-white/10 dark:bg-slate-800/40">
  <div class="flex flex-wrap items-center gap-4 border-b border-slate-200 p-6 dark:border-white/10">
    <span class="flex size-12 shrink-0 items-center justify-center rounded-full bg-indigo-50 text-indigo-700 dark:bg-indigo-400/10 dark:text-indigo-400">
      <%= icon :document, css_class: "size-6" %>
    </span>
    <div class="min-w-0 flex-1">
      <h2 class="text-lg font-semibold text-slate-900 dark:text-white"><%= contrato.morador.nome %> · <%= contrato.unidade.nome %></h2>
      <div class="mt-1 flex flex-wrap gap-2">
        <%= contrato_status_badge(contrato.status) %>
        <%= status_pagamento_badge(contrato.status_pagamento) %>
      </div>
    </div>
  </div>

  <dl class="grid grid-cols-1 gap-x-6 gap-y-5 p-6 sm:grid-cols-2">
    <div>
      <dt class="text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">Fiadores</dt>
      <dd class="mt-1 text-sm text-slate-900 dark:text-white"><%= contrato.fiadores.map(&:nome).join(", ") %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">Valor do aluguel</dt>
      <dd class="mt-1 text-sm text-slate-900 dark:text-white"><%= number_to_currency(contrato.valor_aluguel) %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">Data de início</dt>
      <dd class="mt-1 text-sm text-slate-900 dark:text-white"><%= l(contrato.data_inicio) if contrato.data_inicio %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">Duração</dt>
      <dd class="mt-1 text-sm text-slate-900 dark:text-white"><%= pluralize(contrato.duracao_meses, "mês", plural: "meses") if contrato.duracao_meses %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">Data de fim</dt>
      <dd class="mt-1 text-sm text-slate-900 dark:text-white"><%= contrato.data_fim ? l(contrato.data_fim) : "—" %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">Dia de pagamento</dt>
      <dd class="mt-1 text-sm text-slate-900 dark:text-white">Todo dia <%= contrato.dia_pagamento %></dd>
    </div>
  </dl>
</div>
