<% content_for :title, "Contratos" %>

<div class="w-full">
  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Contratos</h1>
    <%= link_to "Novo contrato", new_contrato_path, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white block font-medium" %>
  </div>

  <div id="contratos" class="min-w-full divide-y divide-gray-200 space-y-5">
    <% if @contratos.any? %>
      <% @contratos.each do |contrato| %>
        <div class="flex flex-col sm:flex-row justify-between items-center pb-5 sm:pb-0">
          <%= render contrato %>
          <div class="w-full sm:w-auto flex flex-col sm:flex-row space-x-2 space-y-2">
            <%= link_to "Ver", contrato, class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
            <%= link_to "Editar", edit_contrato_path(contrato), class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
            <%= button_to "Remover", contrato, method: :delete, class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 text-white bg-red-600 hover:bg-red-500 font-medium cursor-pointer", data: { turbo_confirm: "Tem certeza?" } %>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="text-center my-10">Nenhum contrato encontrado.</p>
    <% end %>
  </div>
</div>
