<div class="rounded-xl border border-slate-200 bg-white p-6 dark:border-white/10 dark:bg-slate-800/40">
  <%= render "shared/error_summary", object: contrato %>

  <%= form_with(model: contrato, html: { autocomplete: "off" }) do |form| %>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      <div>
        <%= form.label :morador_id, "Morador", class: label_classes %>
        <%= form.collection_select :morador_id, Pessoa.order(:nome), :id, :nome, { prompt: "Selecione o morador" }, class: field_classes(contrato, :morador_id) %>
      </div>

      <div>
        <%= form.label :unidade_id, "Unidade", class: label_classes %>
        <%= form.select :unidade_id, unidade_options_for_contrato(contrato), { prompt: "Selecione a unidade" }, class: field_classes(contrato, :unidade) %>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Kitnets com contrato ativo não podem receber outro.</p>
      </div>

      <div class="sm:col-span-2">
        <%= form.label :fiador_ids, "Fiadores", class: label_classes %>
        <%= form.collection_select :fiador_ids, Pessoa.order(:nome), :id, :nome, {}, multiple: true, class: "#{field_classes(contrato, :fiadores)} h-32" %>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Segure Ctrl (ou Cmd) para selecionar mais de um fiador.</p>
      </div>

      <div>
        <%= form.label :data_inicio, class: label_classes %>
        <%= form.date_field :data_inicio, class: field_classes(contrato, :data_inicio) %>
      </div>

      <div>
        <%= form.label :duracao_meses, class: label_classes %>
        <%= form.number_field :duracao_meses, in: 1..120, class: field_classes(contrato, :duracao_meses) %>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
          <% if contrato.new_record? %>
            Uma ordem de pagamento é criada para cada mês, a partir do mês de início.
          <% else %>
            Ao mudar a duração, ordens em aberto são criadas ou removidas; as já pagas não mudam.
          <% end %>
        </p>
      </div>

      <div>
        <%= form.label :valor_aluguel, class: label_classes %>
        <%= money_field form, :valor_aluguel %>
      </div>

      <div>
        <%= form.label :dia_pagamento, "Dia de pagamento", class: label_classes %>
        <%= form.number_field :dia_pagamento, in: 1..31, class: field_classes(contrato, :dia_pagamento) %>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Dia do mês em que o aluguel vence (1 a 31).</p>
      </div>

      <div>
        <%= form.label :status, class: label_classes %>
        <%= form.select :status, Contrato.statuses.keys.map { |s| [t("contrato.status.#{s}"), s] }, {}, class: field_classes(contrato, :status) %>
      </div>
    </div>

    <div class="mt-6 flex items-center justify-end gap-3 border-t border-slate-200 pt-5 dark:border-white/10">
      <%= link_to "Cancelar", contratos_path, class: "rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 dark:border-white/10 dark:text-slate-200 dark:hover:bg-white/5" %>
      <%= form.submit "Salvar", class: "cursor-pointer rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500" %>
    </div>
  <% end %>
</div>
