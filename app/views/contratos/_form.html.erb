<div class="card p-6">
  <%= render "shared/error_summary", object: contrato %>

  <%= form_with(model: contrato, html: { autocomplete: "off" }, data: (contrato.new_record? ? { controller: "valor-base" } : {})) do |form| %>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      <div class="sm:col-span-2">
        <%= form.label :inquilino, "Inquilino (quem vai morar)", class: label_classes %>
        <%= form.text_field :inquilino, class: field_classes(contrato, :inquilino), autofocus: contrato.new_record? %>
      </div>

      <div class="sm:col-span-2">
        <%= form.label :celular, "Celular do inquilino (WhatsApp)", class: label_classes %>
        <%= form.telephone_field :celular, value: contrato.celular_formatado || contrato.celular, placeholder: "(27) 99999-9999", inputmode: "tel",
              class: field_classes(contrato, :celular), data: { controller: "celular", action: "input->celular#formatar" } %>
      </div>

      <div class="sm:col-span-2">
        <%= form.label :fiador, class: label_classes %>
        <%= form.text_field :fiador, placeholder: "Deixe em branco se não tiver", class: field_classes(contrato, :fiador) %>
      </div>

      <div>
        <%= form.label :unidade_id, "Kitnet", class: label_classes %>
        <% ocupadas = Contrato.ativo.where.not(id: contrato.id).includes(:unidade).index_by(&:unidade_id) %>
        <%= form.select :unidade_id,
              options_for_select(Unidade.em_uso.order(:nome).map { |u|
                [ ocupadas[u.id] ? "#{u.nome} — ocupada (#{ocupadas[u.id].inquilino})" : u.nome, u.id,
                  { disabled: ocupadas[u.id].present? && contrato.ativo?, data: { valor_base: u.valor_base && format_money(u.valor_base) } } ]
              }, contrato.unidade_id),
              { prompt: "Selecione a kitnet" },
              class: field_classes(contrato, :unidade), data: { valor_base_target: "unidade", action: "valor-base#preencherValor" } %>
      </div>

      <div>
        <%= form.label :valor, "Valor do aluguel", class: label_classes %>
        <%= money_field form, :valor, data: { valor_base_target: "valor" } %>
      </div>

      <div>
        <%= form.label :duracao_meses, class: label_classes %>
        <%= form.number_field :duracao_meses, in: 1..120, inputmode: "numeric", class: field_classes(contrato, :duracao_meses) %>
      </div>

      <div>
        <%= form.label :dia_vencimento, class: label_classes %>
        <%= form.number_field :dia_vencimento, in: 1..31, inputmode: "numeric", class: field_classes(contrato, :dia_vencimento) %>
      </div>

      <div>
        <%= form.label :data_inicio, "Início do contrato (opcional)", class: label_classes %>
        <%= form.date_field :data_inicio, class: field_classes(contrato, :data_inicio) %>
      </div>

      <div>
        <%= form.label :status, class: label_classes %>
        <%= form.select :status, [ [ "Ativo", "ativo" ], [ "Finalizado", "finalizado" ] ], {}, class: field_classes(contrato, :status) %>
      </div>

      <div class="sm:col-span-2">
        <%= form.label :arquivo_pdf, "Contrato em PDF", class: label_classes %>
        <% if (doc = contrato.documento_info) %>
          <div class="mt-1.5 flex flex-wrap items-center gap-3 rounded-lg bg-slate-50 px-3 py-2.5 ring-1 ring-slate-200 ring-inset dark:bg-white/5 dark:ring-white/10">
            <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-rose-50 text-rose-600 dark:bg-rose-400/10 dark:text-rose-400"><%= icon :document, css_class: "size-5" %></span>
            <div class="min-w-0 flex-1">
              <p class="truncate text-sm font-medium text-slate-900 dark:text-white"><%= doc.nome %></p>
              <p class="text-xs text-slate-500 dark:text-slate-400"><%= number_to_human_size(doc.tamanho) %> · enviado em <%= l(doc.updated_at.to_date) %></p>
            </div>
            <%= link_to "Ver", pdf_contrato_path(contrato), target: "_blank", rel: "noopener", data: { turbo: false }, class: "btn btn-secondary px-3 py-1.5 text-xs" %>
            <label class="flex items-center gap-1.5 text-xs text-slate-600 dark:text-slate-300">
              <%= form.check_box :remover_pdf, class: "rounded border-slate-300 text-rose-600 focus:ring-rose-500" %> remover
            </label>
          </div>
          <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">Para trocar, escolha outro arquivo:</p>
        <% end %>
        <%= form.file_field :arquivo_pdf, accept: "application/pdf,.pdf",
              class: "mt-1.5 block w-full min-w-0 rounded-lg bg-white text-sm text-slate-700 ring-1 ring-inset #{contrato.errors[:arquivo_pdf].any? ? "ring-rose-400" : "ring-slate-300 dark:ring-white/10"} file:mr-3 file:cursor-pointer file:border-0 file:bg-slate-100 file:px-3 file:py-2 file:text-sm file:font-medium file:text-slate-700 dark:bg-white/5 dark:text-slate-300 dark:file:bg-white/10 dark:file:text-slate-200" %>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">PDF de até <%= ContratoDocumento::TAMANHO_MAXIMO / 1.megabyte %> MB. Se o formulário voltar com erro, escolha o arquivo de novo.</p>
      </div>

      <div class="sm:col-span-2">
        <%= form.label :observacoes, class: label_classes %>
        <%= form.text_area :observacoes, rows: 3, class: field_classes(contrato, :observacoes) %>
      </div>
    </div>

    <div class="mt-6 flex items-center justify-end gap-3 border-t border-slate-100 pt-5 dark:border-white/5">
      <%= link_to "Cancelar", contratos_path, class: "btn btn-secondary" %>
      <%= form.submit "Salvar", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
