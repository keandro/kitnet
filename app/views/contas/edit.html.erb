<% content_for :title, "Minha conta" %>

<h1 class="text-2xl font-semibold text-slate-900 dark:text-white">Minha conta</h1>
<p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Altere o e-mail de login ou a senha. Confirme com a senha atual para salvar.</p>

<div class="mt-6 max-w-2xl rounded-xl border border-slate-200 bg-white p-6 dark:border-white/10 dark:bg-slate-800/40">
  <%= render "shared/error_summary", object: @usuario %>

  <%= form_with(model: @usuario, url: conta_path, method: :patch) do |form| %>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      <div class="sm:col-span-2">
        <%= form.label :email, class: label_classes %>
        <%= form.email_field :email, autocomplete: "email", class: field_classes(@usuario, :email) %>
      </div>

      <div>
        <%= form.label :password, class: label_classes %>
        <%= form.password_field :password, autocomplete: "new-password", class: field_classes(@usuario, :password) %>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Deixe em branco para manter a senha atual. Mínimo de 6 caracteres.</p>
      </div>

      <div>
        <%= form.label :password_confirmation, class: label_classes %>
        <%= form.password_field :password_confirmation, autocomplete: "new-password", class: field_classes(@usuario, :password_confirmation) %>
      </div>

      <div class="sm:col-span-2 border-t border-slate-200 pt-5 dark:border-white/10">
        <%= form.label :current_password, class: label_classes %>
        <%= form.password_field :current_password, autocomplete: "current-password", required: true, class: field_classes(@usuario, :current_password) %>
      </div>
    </div>

    <div class="mt-6 flex items-center justify-end gap-3 border-t border-slate-200 pt-5 dark:border-white/10">
      <%= link_to "Cancelar", root_path, class: "rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 dark:border-white/10 dark:text-slate-200 dark:hover:bg-white/5" %>
      <%= form.submit "Salvar", class: "cursor-pointer rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500" %>
    </div>
  <% end %>
</div>
