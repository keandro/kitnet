<% content_for :title, "Locador #{@locador.nome_was}" %>

<%= link_to locadores_path, class: "inline-flex items-center gap-1 text-sm font-medium text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-white" do %>
  <%= icon :arrow_left, css_class: "size-4" %> Locadores
<% end %>

<div class="mt-3 flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-white"><%= @locador.nome_was %></h1>
  <%= button_to @locador, method: :delete, form_class: "inline-block", class: "btn btn-danger",
        data: { turbo_confirm: "Remover o locador #{@locador.nome_was}?#{" Os contratos dele ficam sem locador." if @locador.contratos.exists?}", confirmar_rotulo: "Remover", confirmar_perigo: "true" } do %>
    <%= icon :trash, css_class: "size-4" %> Remover
  <% end %>
</div>

<div class="mt-6 max-w-2xl">
  <%= render "form", locador: @locador %>
</div>
