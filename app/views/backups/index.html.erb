<% content_for :title, "Backup" %>

<h1 class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-white">Backup</h1>
<p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Todos os dados ficam num único arquivo SQLite.</p>

<div class="mt-6 grid grid-cols-1 gap-4 lg:grid-cols-2">
  <section class="card flex flex-col p-5">
    <h2 class="text-sm font-medium text-slate-900 dark:text-white">Exportar</h2>
    <p class="mt-3 text-sm text-slate-700 dark:text-slate-300">
      Baixa uma cópia completa do banco (<%= number_to_human_size(@tamanho) %>). Guarde num pendrive ou na nuvem.
    </p>
    <p class="mt-3 text-xs text-slate-500 dark:text-slate-400"><%= @resumo.map { |nome, total| "#{total} #{nome}" }.join(" · ") %></p>
    <div class="mt-auto pt-4">
      <%= link_to exportar_backup_path, data: { turbo: false }, class: "btn btn-primary" do %>
        <%= icon :download, css_class: "size-4" %> Baixar backup
      <% end %>
    </div>
  </section>

  <section class="card flex flex-col p-5">
    <h2 class="text-sm font-medium text-slate-900 dark:text-white">Importar</h2>
    <p class="mt-3 text-sm text-slate-700 dark:text-slate-300">
      Restaura um backup exportado antes. <strong class="font-semibold text-slate-900 dark:text-white">Substitui todos os dados atuais.</strong>
    </p>
    <p class="mt-3 text-xs text-slate-500 dark:text-slate-400">Antes de trocar, o sistema guarda uma cópia do banco atual na pasta de backups.</p>
    <%= form_with url: importar_backup_path, method: :post, multipart: true, class: "mt-auto pt-4",
                  data: { turbo_confirm: "Importar este backup? Todos os dados atuais serão substituídos (uma cópia deles fica guardada antes).", confirmar_rotulo: "Importar", confirmar_perigo: "true" } do |form| %>
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
        <%= form.file_field :arquivo, accept: ".sqlite3,.sqlite,.db", required: true,
              class: "block w-full min-w-0 rounded-lg border border-slate-300 bg-white text-sm text-slate-700 file:mr-3 file:cursor-pointer file:border-0 file:bg-slate-100 file:px-3 file:py-2 file:text-sm file:font-medium file:text-slate-700 dark:border-white/10 dark:bg-slate-900 dark:text-slate-300 dark:file:bg-white/10 dark:file:text-slate-200" %>
        <%= form.submit "Importar", class: "btn btn-danger shrink-0" %>
      </div>
    <% end %>
  </section>
</div>

<section class="card mt-6 overflow-hidden">
  <div class="border-b border-slate-100 px-5 py-4 dark:border-white/5">
    <h2 class="text-sm font-medium text-slate-900 dark:text-white">Cópias guardadas no computador</h2>
    <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
      Pasta: <code class="break-all rounded bg-slate-100 px-1.5 py-0.5 text-slate-700 dark:bg-white/10 dark:text-slate-300"><%= BancoBackup::PASTA %></code>.
      Um backup automático é feito por dia, no primeiro acesso (os últimos <%= BancoBackup::MANTER_AUTOMATICOS %> ficam guardados).
    </p>
  </div>

  <% if @copias.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-100 dark:divide-white/5">
        <thead class="bg-slate-50/70 dark:bg-white/[0.03]">
          <tr>
            <th class="px-3 py-3 sm:px-4 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Arquivo</th>
            <th class="hidden sm:table-cell px-3 py-3 sm:px-4 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Data</th>
            <th class="px-3 py-3 sm:px-4 text-right text-[11px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Tamanho</th>
            <th class="px-3 py-3 sm:px-4"><span class="sr-only">Baixar</span></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-white/5">
          <% @copias.each do |copia| %>
            <tr class="hover:bg-slate-50 dark:hover:bg-white/5">
              <td class="px-3 py-3 sm:px-4 text-sm">
                <code class="break-all rounded bg-slate-100 px-1.5 py-0.5 text-xs text-slate-700 dark:bg-white/10 dark:text-slate-300"><%= copia.nome %></code>
                <span class="mt-1 block text-xs text-slate-500 sm:hidden dark:text-slate-400"><%= l(copia.data, format: "%d/%m/%Y, %H:%M") %></span>
              </td>
              <td class="hidden sm:table-cell whitespace-nowrap px-3 py-3 sm:px-4 text-sm text-slate-700 dark:text-slate-300"><%= l(copia.data, format: "%d/%m/%Y, %H:%M") %></td>
              <td class="whitespace-nowrap px-3 py-3 sm:px-4 text-right text-sm tabular-nums text-slate-700 dark:text-slate-300"><%= number_to_human_size(copia.tamanho) %></td>
              <td class="whitespace-nowrap px-3 py-3 sm:px-4 text-right">
                <%= link_to icon(:download, css_class: "size-4"), baixar_backup_path(nome: copia.nome), data: { turbo: false }, class: "inline-flex p-1.5 text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400", title: "Baixar #{copia.nome}" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="px-4 py-12 text-center text-sm text-slate-500 dark:text-slate-400">Nenhuma cópia guardada ainda.</p>
  <% end %>
</section>
