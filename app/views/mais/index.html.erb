<% content_for :title, "Mais" %>

<h1 class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-white">Mais</h1>

<nav class="card mt-6 divide-y divide-slate-100 overflow-hidden dark:divide-white/5" aria-label="Mais áreas">
  <% menu_mais.each do |item| %>
    <%= link_to item[:caminho], class: "flex items-center gap-4 px-4 py-4 hover:bg-slate-50 dark:hover:bg-white/5" do %>
      <span class="flex size-10 shrink-0 items-center justify-center rounded-xl <%= icon_chip_classes(item[:tom]) %>"><%= icon item[:icone], css_class: "size-5" %></span>
      <span class="flex-1">
        <span class="block text-sm font-semibold text-slate-900 dark:text-white"><%= item[:rotulo] %></span>
        <span class="block text-xs text-slate-500 dark:text-slate-400"><%= item[:descricao] %></span>
      </span>
      <%= icon :chevron_right, css_class: "size-4 text-slate-400" %>
    <% end %>
  <% end %>
</nav>
