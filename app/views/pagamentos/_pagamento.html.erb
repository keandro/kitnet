<div id="<%= dom_id pagamento %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Valor:</strong>
    <%= number_to_currency(pagamento.valor) %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Vencimento:</strong>
    <%= l(pagamento.data_vencimento) %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Pago em:</strong>
    <%= pagamento.data_pagamento ? l(pagamento.data_pagamento) : "—" %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Observações:</strong>
    <%= pagamento.observacoes.presence || "—" %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Status:</strong>
    <%= status_pagamento_badge(pagamento.status) %>
  </div>
</div>
