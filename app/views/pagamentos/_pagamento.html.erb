<div id="<%= dom_id pagamento %>" class="rounded-xl border border-slate-200 bg-white dark:border-white/10 dark:bg-slate-800/40">
  <div class="flex items-center gap-4 border-b border-slate-200 p-6 dark:border-white/10">
    <span class="flex size-12 shrink-0 items-center justify-center rounded-full bg-indigo-50 text-indigo-700 dark:bg-indigo-400/10 dark:text-indigo-400">
      <%= icon :cash, css_class: "size-6" %>
    </span>
    <div>
      <h2 class="text-lg font-semibold text-slate-900 dark:text-white"><%= number_to_currency(pagamento.valor) %></h2>
      <div class="mt-1"><%= status_pagamento_badge(pagamento.status) %></div>
    </div>
  </div>

  <dl class="grid grid-cols-1 gap-x-6 gap-y-5 p-6 sm:grid-cols-2">
    <div>
      <dt class="text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">Contrato</dt>
      <dd class="mt-1 text-sm text-slate-900 dark:text-white">
        <%= link_to "#{pagamento.contrato.morador.nome} — #{pagamento.contrato.unidade.nome}", pagamento.contrato, class: "text-indigo-600 hover:text-indigo-500 dark:text-indigo-400" %>
      </dd>
    </div>
    <div>
      <dt class="text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">Vencimento</dt>
      <dd class="mt-1 text-sm text-slate-900 dark:text-white"><%= l(pagamento.data_vencimento) %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">Pago em</dt>
      <dd class="mt-1 text-sm text-slate-900 dark:text-white"><%= pagamento.data_pagamento ? l(pagamento.data_pagamento) : "—" %></dd>
    </div>
    <div class="sm:col-span-2">
      <dt class="text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">Observações</dt>
      <dd class="mt-1 text-sm text-slate-900 dark:text-white"><%= pagamento.observacoes.presence || "—" %></dd>
    </div>
  </dl>
</div>
