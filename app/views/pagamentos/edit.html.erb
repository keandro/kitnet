<% content_for :title, "Editar pagamento" %>

<%= link_to (@pagamento.data_pagamento ? pagamentos_path(ano: @pagamento.data_pagamento.year, mes: @pagamento.data_pagamento.month) : pagamentos_path), class: "inline-flex items-center gap-1 text-sm font-medium text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-white" do %>
  <%= icon :arrow_left, css_class: "size-4" %> Pagamentos
<% end %>

<div class="mt-3 flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-white">Editar pagamento</h1>
  <%= button_to @pagamento, method: :delete, form_class: "inline-block", class: "btn btn-danger", data: { turbo_confirm: "Remover o pagamento de #{number_to_currency(@pagamento.valor)} da kitnet #{@pagamento.unidade.nome}?" } do %>
    <%= icon :trash, css_class: "size-4" %> Remover
  <% end %>
</div>

<div class="mt-6 max-w-2xl">
  <%= render "form", pagamento: @pagamento %>
</div>
