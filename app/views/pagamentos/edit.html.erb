<% content_for :title, "Editar pagamento" %>

<%= link_to contrato_path(@pagamento.contrato), class: "inline-flex items-center gap-1 text-sm font-medium text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-white" do %>
  <%= icon :arrow_left, css_class: "size-4" %> Voltar para o contrato
<% end %>

<h1 class="mt-3 text-2xl font-semibold text-slate-900 dark:text-white">Editar pagamento — <%= @pagamento.contrato.morador.nome %></h1>

<div class="mt-6">
  <%= render "form", pagamento: @pagamento %>
</div>
