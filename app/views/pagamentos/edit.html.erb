<% content_for :title, "Editar pagamento" %>

<div class="md:w-2/3 w-full">
  <h1 class="font-bold text-4xl">Editar pagamento — <%= @contrato.morador.nome %></h1>

  <%= render "form", pagamento: @pagamento, contrato: @contrato %>

  <%= link_to "Voltar para o contrato", contrato_path(@contrato), class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
</div>
