<% content_for :title, "Editar pagamento" %>

<%= link_to (@pagamento.data_pagamento ? root_path(ano: @pagamento.data_pagamento.year, mes: @pagamento.data_pagamento.month) : root_path), class: "inline-flex items-center gap-1 text-sm font-medium text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-white" do %>
  <%= icon :arrow_left, css_class: "size-4" %> Pagamentos
<% end %>

<div class="mt-3 flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-semibold text-slate-900 dark:text-white">Editar pagamento</h1>
  <%= button_to @pagamento, method: :delete, form_class: "inline-block", class: "inline-flex cursor-pointer items-center gap-1.5 rounded-lg border border-rose-200 px-3 py-2 text-sm font-medium text-rose-600 hover:bg-rose-50 dark:border-rose-400/20 dark:text-rose-400 dark:hover:bg-rose-400/10", data: { turbo_confirm: "Remover o pagamento de #{number_to_currency(@pagamento.valor)} da kitnet #{@pagamento.unidade.nome}?" } do %>
    <%= icon :trash, css_class: "size-4" %> Remover
  <% end %>
</div>

<div class="mt-6 max-w-2xl">
  <%= render "form", pagamento: @pagamento %>
</div>
