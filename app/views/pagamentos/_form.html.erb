<div class="rounded-xl border border-slate-200 bg-white p-6 dark:border-white/10 dark:bg-slate-800/40">
  <%= render "shared/error_summary", object: pagamento %>

  <%= form_with(model: pagamento, html: { autocomplete: "off" }, data: (pagamento.new_record? ? { controller: "pagamento-form" } : {})) do |form| %>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      <div>
        <%= form.label :unidade_id, "Kitnet", class: label_classes %>
        <%= form.select :unidade_id,
              options_for_select(Unidade.order(:nome).map { |u| [ u.nome, u.id, { data: { valor_base: u.valor_base && format_money(u.valor_base) } } ] }, pagamento.unidade_id),
              { prompt: "Selecione a kitnet" },
              class: field_classes(pagamento, :unidade), data: { pagamento_form_target: "unidade", action: "pagamento-form#preencherValor" } %>
      </div>

      <div>
        <%= form.label :valor, class: label_classes %>
        <%= money_field form, :valor, data: { pagamento_form_target: "valor" } %>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Vem do valor base da kitnet; ajuste se precisar.</p>
      </div>

      <div>
        <%= form.label :data_pagamento, class: label_classes %>
        <%= form.date_field :data_pagamento, max: Date.current, class: field_classes(pagamento, :data_pagamento) %>
      </div>

      <div class="sm:col-span-2">
        <%= form.label :observacoes, class: label_classes %>
        <%= form.text_area :observacoes, rows: 3, class: field_classes(pagamento, :observacoes) %>
      </div>
    </div>

    <div class="mt-6 flex items-center justify-end gap-3 border-t border-slate-200 pt-5 dark:border-white/10">
      <%= link_to "Cancelar", (pagamento.data_pagamento ? root_path(ano: pagamento.data_pagamento.year, mes: pagamento.data_pagamento.month) : root_path), class: "rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 dark:border-white/10 dark:text-slate-200 dark:hover:bg-white/5" %>
      <%= form.submit "Salvar", class: "cursor-pointer rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500" %>
    </div>
  <% end %>
</div>
