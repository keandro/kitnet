<div class="rounded-xl border border-slate-200 bg-white p-6 dark:border-white/10 dark:bg-slate-800/40">
  <%= render "shared/error_summary", object: pagamento %>

  <%= form_with(model: pagamento) do |form| %>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      <div class="sm:col-span-2">
        <%= form.label :contrato_id, "Contrato", class: label_classes %>
        <%= form.collection_select :contrato_id, Contrato.includes(:morador, :unidade).order(:id), :id, ->(c) { "#{c.morador.nome} — #{c.unidade.nome}" }, { prompt: "Selecione o contrato" }, class: field_classes(pagamento, :contrato_id) %>
      </div>

      <div>
        <%= form.label :valor, class: label_classes %>
        <%= form.text_field :valor, class: field_classes(pagamento, :valor) %>
      </div>

      <div>
        <%= form.label :data_vencimento, class: label_classes %>
        <%= form.date_field :data_vencimento, class: field_classes(pagamento, :data_vencimento) %>
      </div>

      <div class="sm:col-span-2">
        <%= form.label :data_pagamento, "Data do pagamento", class: label_classes %>
        <p class="text-xs text-slate-500 dark:text-slate-400">Deixe em branco se ainda não foi pago.</p>
        <%= form.date_field :data_pagamento, class: field_classes(pagamento, :data_pagamento) %>
      </div>

      <div class="sm:col-span-2">
        <%= form.label :observacoes, class: label_classes %>
        <%= form.text_area :observacoes, rows: 3, class: field_classes(pagamento, :observacoes) %>
      </div>
    </div>

    <div class="mt-6 flex items-center justify-end gap-3 border-t border-slate-200 pt-5 dark:border-white/10">
      <%= link_to "Cancelar", (pagamento.contrato_id.present? ? pagamento.contrato : pagamentos_path), class: "rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 dark:border-white/10 dark:text-slate-200 dark:hover:bg-white/5" %>
      <%= form.submit "Salvar", class: "cursor-pointer rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500" %>
    </div>
  <% end %>
</div>
