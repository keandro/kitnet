<%= form_with(model: pagamento, url: (pagamento.new_record? ? contrato_pagamentos_path(contrato) : pagamento_path(pagamento)), class: "contents") do |form| %>
  <% if pagamento.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2>Corrija os erros abaixo antes de salvar este pagamento (<%= pluralize(pagamento.errors.count, "erro") %>):</h2>

      <ul class="list-disc ml-6">
        <% pagamento.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :valor %>
    <%= form.text_field :valor, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": pagamento.errors[:valor].none?, "border-red-400 focus:outline-red-600": pagamento.errors[:valor].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :data_vencimento %>
    <%= form.date_field :data_vencimento, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": pagamento.errors[:data_vencimento].none?, "border-red-400 focus:outline-red-600": pagamento.errors[:data_vencimento].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :data_pagamento, "Data do pagamento (deixe em branco se ainda não foi pago)" %>
    <%= form.date_field :data_pagamento, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": pagamento.errors[:data_pagamento].none?, "border-red-400 focus:outline-red-600": pagamento.errors[:data_pagamento].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :observacoes %>
    <%= form.text_area :observacoes, rows: 3, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": pagamento.errors[:observacoes].none?, "border-red-400 focus:outline-red-600": pagamento.errors[:observacoes].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
