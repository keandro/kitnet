<div class="card p-6">
  <%= render "shared/error_summary", object: pagamento %>

  <%= form_with(model: pagamento, html: { autocomplete: "off" }, data: (pagamento.new_record? ? { controller: "valor-base", valor_base_referencia_value: (@referencia || Date.current).iso8601, valor_base_hoje_value: Date.current.iso8601 } : {})) do |form| %>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      <div>
        <%= form.label :unidade_id, "Kitnet", class: label_classes %>
        <%= form.select :unidade_id,
              options_for_select(Unidade.order(:nome).map { |u| [ u.nome, u.id, { data: { valor_base: u.valor_base && format_money(u.valor_base), dia_pagamento: u.dia_pagamento } } ] }, pagamento.unidade_id),
              { prompt: "Selecione a kitnet" },
              class: field_classes(pagamento, :unidade), data: { valor_base_target: "unidade", action: "valor-base#preencherValor valor-base#preencherData" } %>
      </div>

      <div>
        <%= form.label :valor, class: label_classes %>
        <%= money_field form, :valor, data: { valor_base_target: "valor" } %>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Em branco é R$ 0,00 (kitnet vazia no mês).</p>
      </div>

      <div>
        <%= form.label :data_pagamento, class: label_classes %>
        <%= form.date_field :data_pagamento, max: Date.current, class: field_classes(pagamento, :data_pagamento), data: { valor_base_target: "data" } %>
      </div>

      <div class="sm:col-span-2">
        <%= form.label :observacoes, class: label_classes %>
        <%= form.text_area :observacoes, rows: 3, class: field_classes(pagamento, :observacoes) %>
      </div>
    </div>

    <div class="mt-6 flex items-center justify-end gap-3 border-t border-slate-100 pt-5 dark:border-white/5">
      <%= link_to "Cancelar", (pagamento.data_pagamento ? pagamentos_path(ano: pagamento.data_pagamento.year, mes: pagamento.data_pagamento.month) : pagamentos_path), class: "btn btn-secondary" %>
      <%= form.submit "Salvar", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
