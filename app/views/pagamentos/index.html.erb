<% content_for :title, "Pagamentos" %>

<div class="flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-semibold text-slate-900 dark:text-white">Pagamentos<%= " — #{@contrato.morador.nome}" if @contrato %></h1>
    <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
      <%= @contrato ? @contrato.unidade.nome : "Ordens de pagamento de todos os contratos. Elas são criadas automaticamente junto com o contrato." %>
    </p>
  </div>
</div>

<% if @contrato %>
  <%= link_to contrato_path(@contrato), class: "mt-4 inline-flex items-center gap-1 text-sm font-medium text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-white" do %>
    <%= icon :arrow_left, css_class: "size-4" %> Voltar para o contrato
  <% end %>
<% end %>

<div class="mt-6 overflow-hidden rounded-xl border border-slate-200 bg-white dark:border-white/10 dark:bg-slate-800/40">
  <% if @pagamentos.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200 dark:divide-white/10">
        <%= render "table_head", show_contrato: @contrato.nil? %>
        <tbody class="divide-y divide-slate-100 dark:divide-white/5">
          <%= render partial: "pagamento_row", collection: @pagamentos, as: :pagamento, locals: { show_contrato: @contrato.nil? } %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="px-4 py-12 text-center">
      <%= icon :cash, css_class: "mx-auto size-8 text-slate-300 dark:text-slate-600" %>
      <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">Nenhuma ordem de pagamento.</p>
    </div>
  <% end %>
</div>
