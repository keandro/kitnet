<% nome_mes = "#{t("date.month_names")[@mes.month]} de #{@mes.year}" %>
<% content_for :title, "Pagamentos — #{nome_mes}" %>

<%# pagamento de R$ 0,00 no mês = kitnet vazia: não é cobrada nem conta como paga %>
<% vazias = @unidades.select { |u| @por_unidade[u.id]&.sum(&:valor)&.zero? } %>
<% cobradas = @unidades.select(&:valor_base) - vazias %>
<% faltam = cobradas.reject { |u| @por_unidade.key?(u.id) } %>
<% recebido = @pagamentos.sum(&:valor) %>
<% data_sugerida = @mes == Date.current.beginning_of_month ? Date.current : [ @mes.end_of_month, Date.current ].min %>

<div class="flex flex-wrap items-center justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-white">Pagamentos</h1>
  </div>
  <div class="flex flex-wrap items-center gap-2">
    <%= render "energia/navegacao_mes", conta: Struct.new(:ano, :mes).new(@mes.year, @mes.month), rota: :pagamentos_path %>
    <%= link_to new_pagamento_path(data: data_sugerida), class: "btn btn-primary" do %>
      <%= icon :plus, css_class: "size-4" %> Registrar pagamento
    <% end %>
  </div>
</div>

<div class="mt-6 grid grid-cols-2 gap-3 sm:gap-4 sm:grid-cols-3">
  <%= render "shared/stat_tile", classe: "col-span-2 sm:col-span-1", label: "Recebido no mês", value: number_to_currency(recebido), icon_name: :cash, tone: :good, value_class: "text-xl",
        sublabel: "#{@pagamentos.size} #{@pagamentos.size == 1 ? "pagamento" : "pagamentos"}" %>
  <%= render "shared/stat_tile", label: "Kitnets que pagaram", value: "#{cobradas.size - faltam.size} de #{cobradas.size}", icon_name: :check_circle, tone: :primary, value_class: "text-xl",
        sublabel: (vazias.any? ? "#{vazias.size} #{vazias.size == 1 ? "vazia" : "vazias"}: #{vazias.map(&:nome).join(", ")}" : nil) %>
  <%= render "shared/stat_tile", label: "Faltam pagar", value: faltam.size, icon_name: :clock, tone: (faltam.any? ? :critical : :good), value_class: "text-xl",
        sublabel: (faltam.any? ? faltam.map(&:nome).join(", ") : "todas pagaram") %>
</div>

<section class="card mt-6 overflow-hidden">
  <div class="border-b border-slate-100 px-5 py-4 dark:border-white/5">
    <h2 class="text-sm font-medium text-slate-900 dark:text-white">Por kitnet</h2>
  </div>
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-slate-100 dark:divide-white/5">
      <thead class="bg-slate-50/70 dark:bg-white/[0.03]">
        <tr>
          <th class="px-3 py-3 sm:px-4 max-[359px]:px-2 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Kitnet</th>
          <th class="hidden sm:table-cell px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-[11px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Valor base</th>
          <th class="px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-[11px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Pago no mês</th>
          <th class="hidden sm:table-cell px-3 py-3 sm:px-4 max-[359px]:px-2 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Pagamento</th>
          <th class="px-3 py-3 sm:px-4 max-[359px]:px-2"><span class="sr-only">Ações</span></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 dark:divide-white/5">
        <% @unidades.each do |unidade| %>
          <% pagos = @por_unidade[unidade.id] || [] %>
          <% vazia = vazias.include?(unidade) %>
          <tr class="cursor-pointer hover:bg-slate-50 dark:hover:bg-white/5" data-controller="row-link" data-row-link-url-value="<%= unidade_path(unidade) %>" data-action="click->row-link#visit">
            <td class="px-3 py-3 sm:px-4 max-[359px]:px-2 text-sm font-medium text-slate-900 dark:text-white"><%= unidade.nome %></td>
            <td class="hidden sm:table-cell whitespace-nowrap px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-sm tabular-nums text-slate-500 dark:text-slate-400"><%= unidade.valor_base ? number_to_currency(unidade.valor_base) : "—" %></td>
            <td class="whitespace-nowrap px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-sm font-medium tabular-nums text-slate-900 dark:text-white">
              <%= pagos.any? ? number_to_currency(pagos.sum(&:valor)) : "—" %>
              <%# no celular a coluna Pagamento some; a situação vem aqui embaixo %>
              <% if vazia %>
                <span class="block text-xs font-normal text-slate-500 sm:hidden dark:text-slate-400">vazia</span>
              <% elsif pagos.any? %>
                <span class="block text-xs font-normal text-emerald-700 sm:hidden dark:text-emerald-400">✓ <%= pagos.map { |p| l(p.data_pagamento, format: "%d/%m") }.join(", ") %></span>
              <% elsif unidade.valor_base %>
                <span class="block text-xs font-normal text-amber-700 sm:hidden dark:text-amber-400">não pago</span>
              <% end %>
            </td>
            <td class="hidden sm:table-cell whitespace-nowrap px-3 py-3 sm:px-4 max-[359px]:px-2 text-sm">
              <% if vazia %>
                <%= status_badge("Vazia", tone: :neutral, icon: :clock) %>
              <% elsif pagos.any? %>
                <%= status_badge("Pago em #{pagos.map { |p| l(p.data_pagamento, format: "%d/%m") }.join(", ")}", tone: :good, icon: :check_circle) %>
              <% elsif unidade.valor_base %>
                <%= status_badge("Não pago", tone: :warning, icon: :clock) %>
              <% else %>
                <span class="text-slate-400 dark:text-slate-500">—</span>
              <% end %>
            </td>
            <td class="whitespace-nowrap px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-sm">
              <%= link_to new_pagamento_path(unidade_id: unidade.id, data: data_sugerida), class: "acao acao-verde" do %>
                <%= icon :plus, css_class: "size-4" %> Registrar
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>

<%# custos do mês (os mesmos de Finanças) %>
<section class="card mt-6 p-5">
  <h2 class="text-sm font-medium text-slate-900 dark:text-white">Custos do mês</h2>
  <%= render "shared/error_summary", object: @fechamento %>
  <%= form_with(model: @fechamento, url: fechamento_mensal_path(ano: @mes.year, mes: @mes.month), method: :patch, html: { autocomplete: "off" }, class: "mt-4") do |form| %>
    <%= hidden_field_tag :retorno, "pagamentos" %>
    <div class="grid grid-cols-1 items-end gap-4 sm:grid-cols-3">
      <div>
        <%= form.label :despesas_gerais, class: label_classes %>
        <%= money_field form, :despesas_gerais %>
      </div>
      <div>
        <%= form.label :agua_esgoto, class: label_classes %>
        <%= money_field form, :agua_esgoto %>
      </div>
      <div>
        <%= form.submit "Salvar custos", class: "btn btn-primary w-full" %>
      </div>
    </div>
  <% end %>
</section>
