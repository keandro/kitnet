<% content_for :title, "Pagamentos" %>

<div class="flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-semibold text-slate-900 dark:text-white">Pagamentos<%= " — #{@contrato.morador.nome}" if @contrato %></h1>
    <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
      <%= @contrato ? @contrato.unidade.nome : "Histórico de pagamentos de todos os contratos." %>
    </p>
  </div>
  <%= link_to new_pagamento_path(contrato_id: @contrato&.id), class: "inline-flex items-center gap-1.5 rounded-lg bg-indigo-600 px-3.5 py-2 text-sm font-medium text-white hover:bg-indigo-500" do %>
    <%= icon :plus, css_class: "size-4" %> Novo pagamento
  <% end %>
</div>

<% if @contrato %>
  <%= link_to contrato_path(@contrato), class: "mt-4 inline-flex items-center gap-1 text-sm font-medium text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-white" do %>
    <%= icon :arrow_left, css_class: "size-4" %> Voltar para o contrato
  <% end %>
<% end %>

<div class="mt-6 overflow-hidden rounded-xl border border-slate-200 bg-white dark:border-white/10 dark:bg-slate-800/40">
  <% if @pagamentos.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200 dark:divide-white/10">
        <thead class="bg-slate-50 dark:bg-white/5">
          <tr>
            <% if @contrato.nil? %>
              <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">Contrato</th>
            <% end %>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">Valor</th>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">Vencimento</th>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">Pago em</th>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">Status</th>
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-white/5">
          <%= render partial: "pagamento_row", collection: @pagamentos, as: :pagamento, locals: { show_contrato: @contrato.nil? } %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="px-4 py-12 text-center">
      <%= icon :cash, css_class: "mx-auto size-8 text-slate-300 dark:text-slate-600" %>
      <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">Nenhum pagamento registrado.</p>
    </div>
  <% end %>
</div>
