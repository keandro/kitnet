<% content_for :title, "Pagamentos" %>

<div class="w-full">
  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Pagamentos — <%= @contrato.morador.nome %></h1>
    <%= link_to "Novo pagamento", new_contrato_pagamento_path(@contrato), class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white block font-medium" %>
  </div>

  <div id="pagamentos" class="min-w-full divide-y divide-gray-200 space-y-5">
    <% if @pagamentos.any? %>
      <% @pagamentos.each do |pagamento| %>
        <div class="flex flex-col sm:flex-row justify-between items-center pb-5 sm:pb-0">
          <%= render pagamento %>
          <div class="w-full sm:w-auto flex flex-col sm:flex-row space-x-2 space-y-2">
            <%= link_to "Ver", pagamento, class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
            <%= link_to "Editar", edit_pagamento_path(pagamento), class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
            <%= button_to "Remover", pagamento, method: :delete, class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 text-white bg-red-600 hover:bg-red-500 font-medium cursor-pointer", data: { turbo_confirm: "Tem certeza?" } %>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="text-center my-10">Nenhum pagamento registrado.</p>
    <% end %>
  </div>

  <%= link_to "Voltar para o contrato", contrato_path(@contrato), class: "w-full sm:w-auto text-center mt-5 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
</div>
