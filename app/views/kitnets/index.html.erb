<% content_for :title, "Kitnets" %>

<div class="flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-semibold text-slate-900 dark:text-white">Kitnets</h1>
    <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Visão geral de todas as unidades, por andar.</p>
  </div>
  <%= link_to new_unidade_path, class: "inline-flex items-center gap-1.5 rounded-lg bg-indigo-600 px-3.5 py-2 text-sm font-medium text-white hover:bg-indigo-500" do %>
    <%= icon :plus, css_class: "size-4" %> Nova unidade
  <% end %>
</div>

<% if @grupos.empty? %>
  <div class="mt-6 rounded-xl border border-slate-200 bg-white px-4 py-12 text-center dark:border-white/10 dark:bg-slate-800/40">
    <%= icon :building, css_class: "mx-auto size-8 text-slate-300 dark:text-slate-600" %>
    <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">Nenhuma kitnet cadastrada ainda.</p>
  </div>
<% else %>
  <% @grupos.each do |chave, unidades| %>
    <div class="mt-8">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400"><%= andar_label(chave) %></h2>

      <div class="mt-3 grid grid-cols-2 gap-4 sm:grid-cols-4">
        <% unidades.each do |unidade| %>
          <%= link_to unidade, class: "block rounded-xl border bg-white p-5 transition hover:shadow-md dark:bg-slate-800/40 #{unidade_card_classes(unidade.status)}" do %>
            <div class="flex items-start justify-between">
              <span class="text-2xl font-semibold text-slate-900 dark:text-white"><%= unidade.nome %></span>
              <%= unidade_status_badge(unidade.status) %>
            </div>

            <div class="mt-4 text-sm">
              <% if unidade.morador_atual %>
                <p class="flex items-center gap-1.5 font-medium text-slate-900 dark:text-white">
                  <%= icon :users, css_class: "size-4 text-slate-400" %> <%= unidade.morador_atual.nome %>
                </p>
              <% else %>
                <p class="text-slate-400 dark:text-slate-500">Sem morador</p>
              <% end %>
            </div>

            <% if unidade.valor_base %>
              <p class="mt-3 text-sm text-slate-500 dark:text-slate-400"><%= number_to_currency(unidade.valor_base) %></p>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>
