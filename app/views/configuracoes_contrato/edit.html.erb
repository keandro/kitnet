<% content_for :title, "Modelo do contrato" %>

<%= link_to contratos_path, class: "inline-flex items-center gap-1 text-sm font-medium text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-white" do %>
  <%= icon :arrow_left, css_class: "size-4" %> Contratos
<% end %>

<h1 class="mt-3 text-2xl font-semibold tracking-tight text-slate-900 dark:text-white">Modelo do contrato</h1>
<p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Dados e texto que se repetem em todos os contratos para assinar. A conta para pagamento é escolhida em cada contrato.</p>

<div class="card mt-6 max-w-4xl p-6">
  <%= render "shared/error_summary", object: @configuracao %>

  <%= form_with model: @configuracao, url: modelo_de_contrato_path, method: :patch, html: { autocomplete: "off" } do |form| %>
    <h2 class="text-[11px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Locador</h2>
    <div class="mt-3 grid grid-cols-1 gap-5 sm:grid-cols-2">
      <div class="sm:col-span-2">
        <%= form.label :locador_nome, "Nome completo", class: label_classes %>
        <%= form.text_field :locador_nome, class: field_classes(@configuracao, :locador_nome) %>
      </div>
      <div>
        <%= form.label :locador_qualificacao, "Nacionalidade, estado civil, profissão", class: label_classes %>
        <%= form.text_field :locador_qualificacao, placeholder: "brasileiro, solteiro, advogado", class: field_classes(@configuracao, :locador_qualificacao) %>
      </div>
      <div>
        <%= form.label :locador_cpf, "CPF", class: label_classes %>
        <%= form.text_field :locador_cpf, inputmode: "numeric", class: field_classes(@configuracao, :locador_cpf) %>
      </div>
      <div class="sm:col-span-2">
        <%= form.label :locador_endereco, "Endereço", class: label_classes %>
        <%= form.text_field :locador_endereco, class: field_classes(@configuracao, :locador_endereco) %>
      </div>
    </div>

    <h2 class="mt-8 text-[11px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Imóvel e taxa</h2>
    <div class="mt-3 grid grid-cols-1 gap-5 sm:grid-cols-2">
      <div>
        <%= form.label :imovel_endereco, "Rua e número do prédio", class: label_classes %>
        <%= form.text_field :imovel_endereco, placeholder: "rua …, 340", class: field_classes(@configuracao, :imovel_endereco) %>
      </div>
      <div>
        <%= form.label :imovel_bairro_cidade, "Bairro e cidade", class: label_classes %>
        <%= form.text_field :imovel_bairro_cidade, placeholder: "Itapuã, Vila Velha/ES", class: field_classes(@configuracao, :imovel_bairro_cidade) %>
      </div>
      <div>
        <%= form.label :taxa_limpeza, "Taxa de limpeza e pintura", class: label_classes %>
        <%= money_field form, :taxa_limpeza %>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Em branco ou zero: a cláusula sai do contrato.</p>
      </div>
    </div>

    <h2 class="mt-8 text-[11px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Assinatura e foro</h2>
    <div class="mt-3 grid grid-cols-1 gap-5 sm:grid-cols-2">
      <div>
        <%= form.label :cidade_assinatura, "Cidade da assinatura", class: label_classes %>
        <%= form.text_field :cidade_assinatura, placeholder: "Vila Velha", class: field_classes(@configuracao, :cidade_assinatura) %>
      </div>
      <div>
        <%= form.label :foro, "Foro", class: label_classes %>
        <%= form.text_field :foro, placeholder: "Vila Velha/ES", class: field_classes(@configuracao, :foro) %>
      </div>
    </div>

    <div data-controller="texto-contrato">
      <h2 class="mt-8 text-[11px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Texto do contrato</h2>
      <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Mude, apague ou acrescente cláusulas. A data do dia, as assinaturas e as testemunhas entram sozinhas no fim.</p>

      <details class="mt-3 rounded-xl bg-slate-50 text-sm ring-1 ring-slate-200 ring-inset dark:bg-white/5 dark:ring-white/10">
        <summary class="cursor-pointer select-none px-4 py-3 font-semibold text-slate-900 dark:text-white">Como escrever</summary>
        <div class="space-y-4 border-t border-slate-200 px-4 py-4 text-slate-600 dark:border-white/10 dark:text-slate-300">
          <p>Cada linha vira um parágrafo. O começo da linha diz o que ela é:</p>
          <dl class="grid grid-cols-1 gap-x-4 gap-y-1.5 sm:grid-cols-[auto_1fr]">
            <% [ [ "# Texto", "título do contrato, centralizado" ], [ "## Texto", "título de uma seção" ], [ "> Texto", "parágrafo com recuo" ],
                 [ "1- Texto", "cláusula; a numeração é refeita em ordem, então pode usar qualquer número" ], [ "a) Texto", "item de uma lista" ],
                 [ "**texto**", "negrito" ], [ "__texto__", "sublinhado" ],
                 [ "[se tiver fiador] … [fim]", "só entra quando o contrato tem fiador (também: [se não tiver fiador], [se tiver taxa de limpeza])" ] ].each do |marca, explicacao| %>
              <dt><code class="rounded bg-white px-1.5 py-0.5 font-mono text-xs text-slate-800 ring-1 ring-slate-200 dark:bg-slate-900 dark:text-slate-100 dark:ring-white/10"><%= marca %></code></dt>
              <dd class="mb-1.5 min-w-0 sm:mb-0"><%= explicacao %></dd>
            <% end %>
          </dl>
          <p>Campos entre chaves são trocados pelos dados do contrato. Toque num campo para escrevê-lo onde está o cursor:</p>
          <% ModeloDeContrato::CAMPOS.each do |grupo, campos| %>
            <div>
              <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400"><%= grupo %></p>
              <div class="mt-1.5 flex flex-wrap gap-1.5">
                <% campos.each do |campo| %>
                  <button type="button" data-action="texto-contrato#inserir" data-texto-contrato-campo-param="<%= campo %>"
                          class="rounded-md bg-white px-2 py-1 font-mono text-xs text-indigo-700 ring-1 ring-slate-200 hover:bg-indigo-50 dark:bg-slate-900 dark:text-indigo-300 dark:ring-white/10 dark:hover:bg-indigo-400/10">{<%= campo %>}</button>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </details>

      <%= form.text_area :texto_modelo, value: @configuracao.texto_do_contrato,
            rows: 28, spellcheck: true, data: { texto_contrato_target: "texto" },
            class: "#{field_classes(@configuracao, :texto_modelo)} font-mono text-[13px] leading-relaxed", aria: { label: "Texto do contrato" } %>
    </div>

    <div class="mt-6 flex flex-wrap items-center justify-end gap-3 border-t border-slate-100 pt-5 dark:border-white/5">
      <%= link_to exemplo_do_modelo_de_contrato_path, target: "_blank", rel: "noopener", data: { turbo: false }, class: "btn btn-secondary mr-auto" do %>
        <%= icon :document, css_class: "size-4" %> Ver PDF de exemplo
      <% end %>
      <% if @configuracao.texto_modelo_in_database.present? %>
        <%= form.button "Restaurar texto original", name: "restaurar", value: "1", class: "btn btn-amarelo",
              data: { turbo_confirm: "Voltar o texto do contrato ao original? As mudanças feitas no texto se perdem.", confirmar_rotulo: "Restaurar", confirmar_perigo: "true" } %>
      <% end %>
      <%= link_to "Cancelar", contratos_path, class: "btn btn-secondary" %>
      <%= form.submit "Salvar", class: "btn btn-primary" %>
    </div>
    <p class="mt-2 text-right text-xs text-slate-500 dark:text-slate-400">O PDF de exemplo mostra o texto salvo — salve antes de ver.</p>
  <% end %>
</div>
