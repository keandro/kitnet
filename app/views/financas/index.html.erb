<% content_for :title, "Finanças" %>

<div class="flex flex-wrap items-center justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold text-slate-900 dark:text-white">Finanças</h1>
  </div>

  <nav class="flex flex-wrap items-center gap-1 rounded-lg border border-slate-200 bg-white p-1 dark:border-white/10 dark:bg-slate-800/40" aria-label="Ano">
    <% @anos.each do |ano| %>
      <%= link_to ano, financas_path(ano: ano),
            class: "rounded-md px-3 py-1.5 text-sm font-medium #{ano == @ano ? "bg-indigo-600 text-white" : "text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-white/5"}",
            aria: { current: (ano == @ano ? "page" : nil) } %>
    <% end %>
  </nav>
</div>

<% custos = @totais[:despesas_gerais] + @totais[:agua_esgoto] %>
<div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
  <%= render "shared/stat_tile", label: "Resultado em #{@ano}", value: number_to_currency(@totais[:resultado]), icon_name: :chart, tone: (@totais[:resultado].negative? ? :critical : :good), value_class: "text-xl",
        sublabel: (@meses_com_movimento.positive? ? "média de #{number_to_currency(@media_mensal)} por mês (#{pluralize(@meses_com_movimento, "mês", plural: "meses")})" : "sem movimento no ano") %>
  <%= render "shared/stat_tile", label: "Recebido em #{@ano}", value: number_to_currency(@total_recebido), icon_name: :cash, tone: :primary, value_class: "text-xl" %>
  <%= render "shared/stat_tile", label: "Custos em #{@ano}", value: number_to_currency(custos), icon_name: :exclamation_triangle, tone: :critical, value_class: "text-xl" %>
  <%= render "shared/stat_tile", label: "Energia solar em #{@ano}", value: valor_com_sinal(@totais[:energia_solar]).sub("—", number_to_currency(0)), icon_name: :sun, tone: :info, value_class: "text-xl" %>
</div>

<% escala = escala_financas(@meses.map { |m| m[:resultado] }) %>
<% zero = posicao_na_escala(0, escala) %>
<section class="mt-6 rounded-xl border border-slate-200 bg-white p-5 dark:border-white/10 dark:bg-slate-800/40">
  <h2 class="text-sm font-medium text-slate-900 dark:text-white">Resultado por mês</h2>

  <div class="mt-6 flex gap-2">
    <%# eixo y %>
    <div class="relative h-56 w-16 shrink-0 text-right text-xs tabular-nums text-slate-500 dark:text-slate-400" aria-hidden="true">
      <% escala[:ticks].each do |tick| %>
        <span class="absolute right-0 translate-y-1/2" style="bottom: <%= posicao_na_escala(tick, escala) %>%"><%= dinheiro_compacto(tick) %></span>
      <% end %>
    </div>

    <div class="min-w-0 flex-1">
      <div class="relative h-56">
        <% escala[:ticks].each do |tick| %>
          <div class="absolute inset-x-0 border-t <%= tick.zero? ? "border-slate-300 dark:border-white/20" : "border-slate-100 dark:border-white/5" %>" style="bottom: <%= posicao_na_escala(tick, escala) %>%"></div>
        <% end %>

        <div class="absolute inset-0 flex gap-0.5">
          <% @meses.each do |m| %>
            <% valor = m[:resultado] %>
            <% topo_barra = posicao_na_escala(valor, escala) %>
            <% base, altura = valor.negative? ? [ topo_barra, zero - topo_barra ] : [ zero, topo_barra - zero ] %>
            <div class="group relative flex h-full flex-1 justify-center" tabindex="0"
                 aria-label="<%= nome_mes(m[:mes]) %>: resultado <%= number_to_currency(valor) %>, recebido <%= number_to_currency(m[:recebido]) %>">
              <% if altura.positive? %>
                <% cor = valor.negative? ? "bg-rose-500 dark:bg-rose-500" : "bg-indigo-600 dark:bg-indigo-500" %>
                <div class="absolute w-full max-w-6 <%= valor.negative? ? "rounded-b-[4px]" : "rounded-t-[4px]" %> <%= cor %>" style="bottom: <%= base %>%; height: <%= altura %>%"></div>
              <% end %>

              <div class="pointer-events-none absolute bottom-full left-1/2 z-10 mb-2 hidden -translate-x-1/2 whitespace-nowrap rounded-lg bg-slate-900 px-3 py-2 text-xs text-white shadow-lg group-hover:block group-focus:block dark:bg-slate-700">
                <p class="font-medium"><%= nome_mes(m[:mes]).capitalize %> de <%= @ano %></p>
                <p class="mt-1 tabular-nums">Resultado: <%= number_to_currency(valor) %></p>
                <p class="tabular-nums text-slate-300">Recebido: <%= number_to_currency(m[:recebido]) %></p>
                <% custos = m[:despesas_gerais] + m[:agua_esgoto] %>
                <% if custos.positive? %>
                  <p class="tabular-nums text-slate-300">Custos: − <%= number_to_currency(custos) %></p>
                <% end %>
                <% unless m[:energia_solar].to_d.zero? %>
                  <p class="tabular-nums text-slate-300">Energia solar: <%= valor_com_sinal(m[:energia_solar]) %></p>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <div class="mt-2 flex gap-0.5 text-xs text-slate-500 dark:text-slate-400" aria-hidden="true">
        <% @meses.each do |m| %>
          <span class="flex-1 text-center"><span class="sm:hidden"><%= nome_mes(m[:mes], abreviado: true).first.upcase %></span><span class="hidden sm:inline"><%= nome_mes(m[:mes], abreviado: true) %></span></span>
        <% end %>
      </div>
    </div>
  </div>
</section>

<section class="mt-6 overflow-hidden rounded-xl border border-slate-200 bg-white dark:border-white/10 dark:bg-slate-800/40">
  <div class="border-b border-slate-200 px-4 py-3 dark:border-white/10">
    <h2 class="text-sm font-medium text-slate-900 dark:text-white">Mês a mês</h2>
  </div>
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-slate-200 dark:divide-white/10">
      <thead class="bg-slate-50 dark:bg-white/5">
        <tr>
          <th class="px-3 py-3 sm:px-4 max-[359px]:px-2 text-left text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">Mês</th>
          <th class="hidden sm:table-cell px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">Recebido</th>
          <th class="hidden sm:table-cell px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400"><span class="sr-only">Menos </span>Despesas gerais</th>
          <th class="hidden sm:table-cell px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400"><span class="sr-only">Menos </span>Água e esgoto</th>
          <th class="hidden sm:table-cell px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400"><span class="sr-only">Mais </span>Energia solar</th>
          <th class="px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">Resultado</th>
          <th class="px-3 py-3 sm:px-4 max-[359px]:px-2"><span class="sr-only">Editar</span></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 dark:divide-white/5">
        <% @meses.each do |m| %>
          <% editar = editar_fechamento_mensal_path(ano: @ano, mes: m[:mes]) %>
          <tr class="cursor-pointer hover:bg-slate-50 dark:hover:bg-white/5"
              data-controller="row-link" data-row-link-url-value="<%= root_path(ano: @ano, mes: m[:mes]) %>" data-action="click->row-link#visit">
            <td class="whitespace-nowrap px-3 py-3 sm:px-4 max-[359px]:px-2 text-sm font-medium text-slate-900 dark:text-white"><%= nome_mes(m[:mes]).capitalize %></td>
            <td class="hidden sm:table-cell whitespace-nowrap px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-sm tabular-nums text-slate-900 dark:text-white"><%= number_to_currency(m[:recebido]) %></td>
            <td class="hidden sm:table-cell whitespace-nowrap px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-sm tabular-nums text-slate-500 dark:text-slate-400"><%= valor_lancado(m[:despesas_gerais], sinal: "−") %></td>
            <td class="hidden sm:table-cell whitespace-nowrap px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-sm tabular-nums text-slate-500 dark:text-slate-400"><%= valor_lancado(m[:agua_esgoto], sinal: "−") %></td>
            <td class="hidden sm:table-cell whitespace-nowrap px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-sm tabular-nums text-slate-500 dark:text-slate-400"><%= valor_com_sinal(m[:energia_solar]) %></td>
            <td class="whitespace-nowrap px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-sm font-medium tabular-nums <%= m[:resultado].negative? ? "text-rose-700 dark:text-rose-400" : "text-slate-900 dark:text-white" %>"><%= number_to_currency(m[:resultado]) %><span class="block text-xs font-normal text-slate-500 sm:hidden dark:text-slate-400">recebido <%= number_to_currency(m[:recebido]) %></span></td>
            <td class="whitespace-nowrap px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-sm">
              <%= link_to icon(:pencil, css_class: "size-4"), editar, class: "inline-flex p-1.5 text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400", title: "Editar custos de #{nome_mes(m[:mes])}" %>
            </td>
          </tr>
        <% end %>
      </tbody>
      <tfoot class="bg-slate-50 dark:bg-white/5">
        <tr>
          <td class="px-3 py-3 sm:px-4 max-[359px]:px-2 text-sm font-semibold text-slate-900 dark:text-white">Total <%= @ano %></td>
          <td class="hidden sm:table-cell px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-sm font-semibold tabular-nums text-slate-900 dark:text-white"><%= number_to_currency(@total_recebido) %></td>
          <td class="hidden sm:table-cell px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-sm font-semibold tabular-nums text-slate-900 dark:text-white"><%= valor_lancado(@totais[:despesas_gerais], sinal: "−") %></td>
          <td class="hidden sm:table-cell px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-sm font-semibold tabular-nums text-slate-900 dark:text-white"><%= valor_lancado(@totais[:agua_esgoto], sinal: "−") %></td>
          <td class="hidden sm:table-cell px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-sm font-semibold tabular-nums text-slate-900 dark:text-white"><%= valor_com_sinal(@totais[:energia_solar]) %></td>
          <td class="px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-sm font-semibold tabular-nums <%= @totais[:resultado].negative? ? "text-rose-700 dark:text-rose-400" : "text-slate-900 dark:text-white" %>"><%= number_to_currency(@totais[:resultado]) %></td>
          <td></td>
        </tr>
      </tfoot>
    </table>
  </div>
</section>
