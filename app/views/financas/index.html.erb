<% content_for :title, "Finanças" %>

<div class="flex flex-wrap items-center justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-white">Finanças</h1>
  </div>

  <nav class="card flex flex-wrap items-center gap-1 rounded-lg p-1" aria-label="Ano">
    <% @anos.each do |ano| %>
      <%= link_to ano, financas_path(ano: ano),
            class: "rounded-lg px-3 py-1.5 text-sm font-semibold transition-colors #{ano == @ano ? "bg-indigo-600 text-white shadow-sm dark:bg-indigo-500" : "text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-white/5"}",
            aria: { current: (ano == @ano ? "page" : nil) } %>
    <% end %>
  </nav>
</div>

<%= render "financas/resumo", resumo: @resumo %>

<section class="card mt-6 overflow-hidden">
  <div class="border-b border-slate-100 px-5 py-4 dark:border-white/5">
    <h2 class="text-sm font-medium text-slate-900 dark:text-white">Mês a mês</h2>
  </div>
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-slate-100 dark:divide-white/5">
      <thead class="bg-slate-50/70 dark:bg-white/[0.03]">
        <tr>
          <th class="px-3 py-3 sm:px-4 max-[359px]:px-2 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Mês</th>
          <th class="hidden sm:table-cell px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-[11px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Recebido</th>
          <th class="hidden sm:table-cell px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-[11px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400"><span class="sr-only">Menos </span>Despesas gerais</th>
          <th class="hidden sm:table-cell px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-[11px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400"><span class="sr-only">Menos </span>Água e esgoto</th>
          <th class="hidden sm:table-cell px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-[11px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400"><span class="sr-only">Mais </span>Energia solar</th>
          <th class="px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-[11px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Resultado</th>
          <th class="px-3 py-3 sm:px-4 max-[359px]:px-2"><span class="sr-only">Editar</span></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 dark:divide-white/5">
        <% @resumo.meses.each do |m| %>
          <% editar = editar_fechamento_mensal_path(ano: @ano, mes: m[:mes]) %>
          <tr class="cursor-pointer hover:bg-slate-50 dark:hover:bg-white/5"
              data-controller="row-link" data-row-link-url-value="<%= pagamentos_path(ano: @ano, mes: m[:mes]) %>" data-action="click->row-link#visit">
            <td class="whitespace-nowrap px-3 py-3 sm:px-4 max-[359px]:px-2 text-sm font-medium text-slate-900 dark:text-white"><%= nome_mes(m[:mes]).capitalize %></td>
            <td class="hidden sm:table-cell whitespace-nowrap px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-sm tabular-nums text-slate-900 dark:text-white"><%= number_to_currency(m[:recebido]) %></td>
            <td class="hidden sm:table-cell whitespace-nowrap px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-sm tabular-nums text-slate-500 dark:text-slate-400"><%= valor_lancado(m[:despesas_gerais], sinal: "−") %></td>
            <td class="hidden sm:table-cell whitespace-nowrap px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-sm tabular-nums text-slate-500 dark:text-slate-400"><%= valor_lancado(m[:agua_esgoto], sinal: "−") %></td>
            <td class="hidden sm:table-cell whitespace-nowrap px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-sm tabular-nums text-slate-500 dark:text-slate-400"><%= valor_com_sinal(m[:energia_solar]) %></td>
            <td class="whitespace-nowrap px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-sm font-medium tabular-nums <%= m[:resultado].negative? ? "text-rose-700 dark:text-rose-400" : "text-slate-900 dark:text-white" %>"><%= number_to_currency(m[:resultado]) %><span class="block text-xs font-normal text-slate-500 sm:hidden dark:text-slate-400">recebido <%= number_to_currency(m[:recebido]) %></span></td>
            <td class="whitespace-nowrap px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-sm">
              <%= link_to icon(:pencil, css_class: "size-4"), editar, class: "acao acao-azul acao-icone", title: "Editar custos de #{nome_mes(m[:mes])}" %>
            </td>
          </tr>
        <% end %>
      </tbody>
      <tfoot class="bg-slate-50 dark:bg-white/5">
        <tr>
          <td class="px-3 py-3 sm:px-4 max-[359px]:px-2 text-sm font-semibold text-slate-900 dark:text-white">Total <%= @ano %></td>
          <td class="hidden sm:table-cell px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-sm font-semibold tabular-nums text-slate-900 dark:text-white"><%= number_to_currency(@resumo.total_recebido) %></td>
          <td class="hidden sm:table-cell px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-sm font-semibold tabular-nums text-slate-900 dark:text-white"><%= valor_lancado(@resumo.totais[:despesas_gerais], sinal: "−") %></td>
          <td class="hidden sm:table-cell px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-sm font-semibold tabular-nums text-slate-900 dark:text-white"><%= valor_lancado(@resumo.totais[:agua_esgoto], sinal: "−") %></td>
          <td class="hidden sm:table-cell px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-sm font-semibold tabular-nums text-slate-900 dark:text-white"><%= valor_com_sinal(@resumo.totais[:energia_solar]) %></td>
          <td class="px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-sm font-semibold tabular-nums <%= @resumo.totais[:resultado].negative? ? "text-rose-700 dark:text-rose-400" : "text-slate-900 dark:text-white" %>"><%= number_to_currency(@resumo.totais[:resultado]) %></td>
          <td></td>
        </tr>
      </tfoot>
    </table>
  </div>
</section>

<%= render "energia_solar/lucro_mes_a_mes", ano: @ano, lucros: @resumo.lucros_solar, lucros_kitnets: @resumo.lucros_solar_kitnets %>
