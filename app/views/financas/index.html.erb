<% content_for :title, "Finanças" %>

<div class="flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold text-slate-900 dark:text-white">Finanças</h1>
    <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Resultado e recebimentos de cada mês de <%= @ano %>.</p>
  </div>

  <nav class="flex flex-wrap items-center gap-1 rounded-lg border border-slate-200 bg-white p-1 dark:border-white/10 dark:bg-slate-800/40" aria-label="Ano">
    <% @anos.each do |ano| %>
      <%= link_to ano, financas_path(ano: ano),
            class: "rounded-md px-3 py-1.5 text-sm font-medium #{ano == @ano ? "bg-indigo-600 text-white" : "text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-white/5"}",
            aria: { current: (ano == @ano ? "page" : nil) } %>
    <% end %>
  </nav>
</div>

<% mes_ref = nome_mes(@mes_referencia) %>
<% anterior_ref = @mes_referencia > 1 ? nome_mes(@mes_referencia - 1) : nil %>
<div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
  <%= render "shared/stat_tile", label: "Resultado de #{mes_ref}", value: number_to_currency(@referencia[:resultado]), icon_name: :cash, tone: :good, value_class: "text-xl",
        sublabel: safe_join([ "Recebido #{number_to_currency(@referencia[:recebido])}",
                              (variacao_mensal(@referencia[:resultado], @referencia[:resultado_anterior], anterior_ref, vazio: "sem resultado") if anterior_ref) ].compact, tag.br) %>
  <%= render "shared/stat_tile", label: "Recebido em #{@ano}", value: number_to_currency(@total_recebido), icon_name: :chart, tone: :primary, value_class: "text-xl",
        sublabel: "de #{number_to_currency(@total_previsto)} previstos no ano" %>
  <%= render "shared/stat_tile", label: "Média mensal", value: number_to_currency(@media_mensal), icon_name: :clock, tone: :info, value_class: "text-xl",
        sublabel: (@mes_referencia > 1 ? "de janeiro a #{mes_ref}" : "janeiro") %>
  <%= render "shared/stat_tile", label: "Em aberto em #{@ano}", value: number_to_currency(@em_aberto), icon_name: :exclamation_triangle, tone: :critical, value_class: "text-xl",
        sublabel: "vencidos e não pagos" %>
</div>

<% escala = escala_financas(@meses.map { |m| m[:resultado] }) %>
<% zero = posicao_na_escala(0, escala) %>
<section class="mt-6 rounded-xl border border-slate-200 bg-white p-5 dark:border-white/10 dark:bg-slate-800/40">
  <h2 class="text-sm font-medium text-slate-900 dark:text-white">Resultado por mês</h2>
  <p class="text-xs text-slate-500 dark:text-slate-400">Recebido + energia solar − despesas gerais − água e esgoto. Em destaque: <%= mes_ref %>.</p>

  <div class="mt-6 flex gap-2">
    <%# eixo y %>
    <div class="relative h-56 w-16 shrink-0 text-right text-xs tabular-nums text-slate-500 dark:text-slate-400" aria-hidden="true">
      <% escala[:ticks].each do |tick| %>
        <span class="absolute right-0 translate-y-1/2" style="bottom: <%= posicao_na_escala(tick, escala) %>%"><%= dinheiro_compacto(tick) %></span>
      <% end %>
    </div>

    <div class="min-w-0 flex-1">
      <div class="relative h-56">
        <% escala[:ticks].each do |tick| %>
          <div class="absolute inset-x-0 border-t <%= tick.zero? ? "border-slate-300 dark:border-white/20" : "border-slate-100 dark:border-white/5" %>" style="bottom: <%= posicao_na_escala(tick, escala) %>%"></div>
        <% end %>

        <div class="absolute inset-0 flex gap-0.5">
          <% @meses.each do |m| %>
            <% destaque = m[:mes] == @mes_referencia %>
            <% valor = m[:resultado] %>
            <% topo_barra = posicao_na_escala(valor, escala) %>
            <% base, altura = valor.negative? ? [ topo_barra, zero - topo_barra ] : [ zero, topo_barra - zero ] %>
            <div class="group relative flex h-full flex-1 justify-center" tabindex="0"
                 aria-label="<%= nome_mes(m[:mes]) %>: resultado <%= number_to_currency(valor) %>, recebido <%= number_to_currency(m[:recebido]) %>">
              <% if altura.positive? %>
                <% cor = if valor.negative?
                           destaque ? "bg-rose-600 dark:bg-rose-500" : "bg-rose-200 dark:bg-rose-500/35"
                         else
                           destaque ? "bg-indigo-600 dark:bg-indigo-500" : "bg-indigo-200 dark:bg-indigo-500/35"
                         end %>
                <div class="absolute w-full max-w-6 <%= valor.negative? ? "rounded-b-[4px]" : "rounded-t-[4px]" %> <%= cor %>" style="bottom: <%= base %>%; height: <%= altura %>%"></div>
                <% if destaque %>
                  <span class="pointer-events-none absolute left-1/2 -translate-x-1/2 whitespace-nowrap text-xs font-medium text-slate-900 dark:text-white <%= valor.negative? ? "pt-1" : "pb-1" %>"
                        style="<%= valor.negative? ? "top: #{100 - base}%" : "bottom: #{base + altura}%" %>"><%= dinheiro_compacto(valor) %></span>
                <% end %>
              <% end %>

              <div class="pointer-events-none absolute bottom-full left-1/2 z-10 mb-2 hidden -translate-x-1/2 whitespace-nowrap rounded-lg bg-slate-900 px-3 py-2 text-xs text-white shadow-lg group-hover:block group-focus:block dark:bg-slate-700">
                <p class="font-medium"><%= nome_mes(m[:mes]).capitalize %> de <%= @ano %></p>
                <p class="mt-1 tabular-nums">Resultado: <%= number_to_currency(valor) %></p>
                <p class="tabular-nums text-slate-300">Recebido: <%= number_to_currency(m[:recebido]) %></p>
                <% custos = m[:despesas_gerais] + m[:agua_esgoto] %>
                <% if custos.positive? %>
                  <p class="tabular-nums text-slate-300">Custos: − <%= number_to_currency(custos) %></p>
                <% end %>
                <% if m[:energia_solar].to_d.positive? %>
                  <p class="tabular-nums text-slate-300">Energia solar: + <%= number_to_currency(m[:energia_solar]) %></p>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <div class="mt-2 flex gap-0.5 text-xs text-slate-500 dark:text-slate-400" aria-hidden="true">
        <% @meses.each do |m| %>
          <span class="flex-1 text-center <%= "font-semibold text-slate-900 dark:text-white" if m[:mes] == @mes_referencia %>"><span class="sm:hidden"><%= nome_mes(m[:mes], abreviado: true).first.upcase %></span><span class="hidden sm:inline"><%= nome_mes(m[:mes], abreviado: true) %></span></span>
        <% end %>
      </div>
    </div>
  </div>
</section>

<section class="mt-6 overflow-hidden rounded-xl border border-slate-200 bg-white dark:border-white/10 dark:bg-slate-800/40">
  <div class="border-b border-slate-200 px-4 py-3 dark:border-white/10">
    <h2 class="text-sm font-medium text-slate-900 dark:text-white">Mês a mês</h2>
    <p class="text-xs text-slate-500 dark:text-slate-400">Resultado = recebido + energia solar − despesas gerais − água e esgoto. Clique num mês para lançar os custos.</p>
  </div>
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-slate-200 dark:divide-white/10">
      <thead class="bg-slate-50 dark:bg-white/5">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">Mês</th>
          <th class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">Previsto</th>
          <th class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">Recebido</th>
          <th class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">Vs mês anterior</th>
          <th class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400"><span class="sr-only">Menos </span>Despesas gerais</th>
          <th class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400"><span class="sr-only">Menos </span>Água e esgoto</th>
          <th class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400"><span class="sr-only">Mais </span>Energia solar</th>
          <th class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">Resultado</th>
          <th class="px-4 py-3"><span class="sr-only">Editar</span></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 dark:divide-white/5">
        <% @meses.each do |m| %>
          <% editar = editar_fechamento_mensal_path(ano: @ano, mes: m[:mes]) %>
          <tr class="cursor-pointer hover:bg-slate-50 dark:hover:bg-white/5 <%= "bg-indigo-50/60 dark:bg-indigo-400/5" if m[:mes] == @mes_referencia %>"
              data-controller="row-link" data-row-link-url-value="<%= editar %>" data-action="click->row-link#visit">
            <td class="whitespace-nowrap px-4 py-3 text-sm font-medium text-slate-900 dark:text-white"><%= nome_mes(m[:mes]).capitalize %></td>
            <td class="whitespace-nowrap px-4 py-3 text-right text-sm tabular-nums text-slate-500 dark:text-slate-400"><%= number_to_currency(m[:previsto]) %></td>
            <td class="whitespace-nowrap px-4 py-3 text-right text-sm tabular-nums text-slate-900 dark:text-white"><%= number_to_currency(m[:recebido]) %></td>
            <td class="whitespace-nowrap px-4 py-3 text-right text-xs">
              <%= m[:mes] > 1 ? variacao_mensal(m[:recebido], m[:anterior], nome_mes(m[:mes] - 1, abreviado: true)) : "—" %>
            </td>
            <td class="whitespace-nowrap px-4 py-3 text-right text-sm tabular-nums text-slate-500 dark:text-slate-400"><%= valor_lancado(m[:despesas_gerais], sinal: "−") %></td>
            <td class="whitespace-nowrap px-4 py-3 text-right text-sm tabular-nums text-slate-500 dark:text-slate-400"><%= valor_lancado(m[:agua_esgoto], sinal: "−") %></td>
            <td class="whitespace-nowrap px-4 py-3 text-right text-sm tabular-nums text-slate-500 dark:text-slate-400"><%= m[:energia_solar] ? valor_lancado(m[:energia_solar], sinal: "+") : "—" %></td>
            <td class="whitespace-nowrap px-4 py-3 text-right text-sm font-medium tabular-nums <%= m[:resultado].negative? ? "text-rose-700 dark:text-rose-400" : "text-slate-900 dark:text-white" %>"><%= number_to_currency(m[:resultado]) %></td>
            <td class="whitespace-nowrap px-4 py-3 text-right text-sm">
              <%= link_to icon(:pencil, css_class: "size-4"), editar, class: "inline-flex p-1.5 text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400", title: "Editar custos de #{nome_mes(m[:mes])}" %>
            </td>
          </tr>
        <% end %>
      </tbody>
      <tfoot class="bg-slate-50 dark:bg-white/5">
        <tr>
          <td class="px-4 py-3 text-sm font-semibold text-slate-900 dark:text-white">Total <%= @ano %></td>
          <td class="px-4 py-3 text-right text-sm font-semibold tabular-nums text-slate-900 dark:text-white"><%= number_to_currency(@total_previsto) %></td>
          <td class="px-4 py-3 text-right text-sm font-semibold tabular-nums text-slate-900 dark:text-white"><%= number_to_currency(@total_recebido) %></td>
          <td></td>
          <td class="px-4 py-3 text-right text-sm font-semibold tabular-nums text-slate-900 dark:text-white"><%= valor_lancado(@totais[:despesas_gerais], sinal: "−") %></td>
          <td class="px-4 py-3 text-right text-sm font-semibold tabular-nums text-slate-900 dark:text-white"><%= valor_lancado(@totais[:agua_esgoto], sinal: "−") %></td>
          <td class="px-4 py-3 text-right text-sm font-semibold tabular-nums text-slate-900 dark:text-white"><%= @totais[:energia_solar].positive? ? valor_lancado(@totais[:energia_solar], sinal: "+") : "—" %></td>
          <td class="px-4 py-3 text-right text-sm font-semibold tabular-nums <%= @totais[:resultado].negative? ? "text-rose-700 dark:text-rose-400" : "text-slate-900 dark:text-white" %>"><%= number_to_currency(@totais[:resultado]) %></td>
          <td></td>
        </tr>
      </tfoot>
    </table>
  </div>
</section>
