<!DOCTYPE html>
<html class="h-full" lang="pt-BR">
  <head>
    <title><%= content_for(:title) ? "#{content_for(:title)} · LF Kitnets" : "LF Kitnets" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="LF Kitnets">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full bg-slate-50 text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100">
    <div class="flex h-full">
      <%# barra lateral (tablet/computador) %>
      <aside class="hidden w-64 shrink-0 flex-col border-r border-slate-200/70 bg-white/80 backdrop-blur lg:flex dark:border-white/5 dark:bg-slate-900/60">
        <div class="flex h-16 shrink-0 items-center gap-3 px-5">
          <%= marca_lf_kitnets %>
          <span class="text-base font-semibold tracking-tight">LF Kitnets</span>
        </div>

        <nav class="flex-1 space-y-1 overflow-y-auto px-3 py-4" aria-label="Menu">
          <% menu_barra_lateral.each_with_index do |grupo, i| %>
            <% if i.positive? %><div class="my-3 border-t border-slate-100 dark:border-white/5"></div><% end %>
            <% grupo.each do |rotulo, caminho, icone| %>
              <%= sidebar_nav_link rotulo, caminho, icone %>
            <% end %>
          <% end %>
        </nav>
      </aside>

      <div class="flex min-w-0 flex-1 flex-col">
        <%# barra superior (celular) %>
        <header class="sticky top-0 z-20 flex h-14 shrink-0 items-center justify-between border-b border-slate-200/70 bg-white/80 px-4 backdrop-blur lg:hidden dark:border-white/5 dark:bg-slate-900/80">
          <div class="flex items-center gap-2.5">
            <%= marca_lf_kitnets(tamanho: "size-7") %>
            <span class="text-base font-semibold tracking-tight">LF Kitnets</span>
          </div>
        </header>

        <main class="flex-1 overflow-y-auto px-4 pt-6 pb-28 sm:px-6 lg:px-10 lg:pt-8 lg:pb-10">
          <div class="mx-auto max-w-6xl">
            <%= yield %>
          </div>
        </main>

        <%# navegação de baixo (celular) %>
        <nav class="fixed inset-x-0 bottom-0 z-20 border-t border-slate-200/70 bg-white/90 pb-[env(safe-area-inset-bottom)] backdrop-blur lg:hidden dark:border-white/5 dark:bg-slate-900/90" aria-label="Menu">
          <div class="mx-auto grid max-w-md grid-cols-5">
            <% menu_principal.each do |item| %>
              <%= bottom_nav_link item[:curto], item[:caminho], item[:icone] %>
            <% end %>
            <%= bottom_nav_link "Mais", mais_path, :menu, ativo: menu_mais_ativo? %>
          </div>
        </nav>
      </div>
    </div>

    <%# avisos (somem sozinhos) %>
    <div class="pointer-events-none fixed inset-x-0 top-16 z-50 flex flex-col items-center gap-2 px-4 lg:top-6 lg:right-6 lg:left-auto lg:items-end">
      <% { notice => :good, alert => :critical }.each do |mensagem, tom| %>
        <% next if mensagem.blank? %>
        <div class="pointer-events-auto flex w-full max-w-sm items-start gap-3 rounded-xl bg-white px-4 py-3 text-sm shadow-lg ring-1 ring-slate-900/10 transition duration-300 dark:bg-slate-800 dark:ring-white/10"
             data-controller="aviso" role="status">
          <%= icon(tom == :good ? :check_circle : :exclamation_triangle, css_class: "mt-0.5 size-5 shrink-0 #{tom == :good ? "text-emerald-600 dark:text-emerald-400" : "text-rose-600 dark:text-rose-400"}") %>
          <p class="flex-1 font-medium text-slate-800 dark:text-slate-100"><%= mensagem %></p>
          <button type="button" data-action="aviso#fechar" class="-m-1 rounded p-1 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200" aria-label="Fechar">
            <%= icon :x_mark, css_class: "size-4" %>
          </button>
        </div>
      <% end %>
    </div>
  </body>
</html>
