<% content_for :title, "Início" %>

<div class="flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-white">Início</h1>
    <p class="mt-1 text-sm text-slate-500 dark:text-slate-400"><%= l(Date.current, format: "%A, %d de %B de %Y").capitalize %></p>
  </div>
  <%= link_to financas_path, class: "btn btn-azul" do %>
    <%= icon :chart, css_class: "size-4" %> Ver Finanças
  <% end %>
</div>

<%= render "financas/notificacoes", notificacoes: @notificacoes %>
<%= render "financas/resumo", resumo: @resumo %>
