<% data = Date.new(conta.ano, conta.mes) %>
<nav class="flex items-center gap-1 rounded-lg border border-slate-200 bg-white p-1 dark:border-white/10 dark:bg-slate-800/40" aria-label="Mês">
  <%= link_to energia_path(ano: data.prev_month.year, mes: data.prev_month.month), class: "rounded-md p-1.5 text-slate-500 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-white/5 dark:hover:text-white", title: "Mês anterior" do %>
    <%= icon :chevron_left, css_class: "size-4" %>
  <% end %>
  <span class="min-w-36 px-2 text-center text-sm font-medium text-slate-900 dark:text-white"><%= nome_do_mes_energia(conta) %></span>
  <%= link_to energia_path(ano: data.next_month.year, mes: data.next_month.month), class: "rounded-md p-1.5 text-slate-500 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-white/5 dark:hover:text-white", title: "Próximo mês" do %>
    <%= icon :chevron_right, css_class: "size-4" %>
  <% end %>
</nav>
