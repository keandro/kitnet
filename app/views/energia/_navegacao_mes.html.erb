<% data = Date.new(conta.ano, conta.mes) %>
<% rota = local_assigns.fetch(:rota, :energia_path) %>
<nav class="flex items-center gap-1 rounded-xl bg-white p-1 shadow-sm ring-1 ring-slate-900/5 dark:bg-slate-900 dark:ring-white/10" aria-label="Mês">
  <%= link_to send(rota, ano: data.prev_month.year, mes: data.prev_month.month), class: "rounded-lg p-2 text-slate-500 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-white/5 dark:hover:text-white", title: "Mês anterior" do %>
    <%= icon :chevron_left, css_class: "size-4" %>
  <% end %>
  <span class="min-w-36 px-2 text-center text-sm font-semibold text-slate-900 dark:text-white"><%= nome_do_mes_energia(conta) %></span>
  <%= link_to send(rota, ano: data.next_month.year, mes: data.next_month.month), class: "rounded-lg p-2 text-slate-500 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-white/5 dark:hover:text-white", title: "Próximo mês" do %>
    <%= icon :chevron_right, css_class: "size-4" %>
  <% end %>
</nav>
