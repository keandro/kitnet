<% content_for :title, "Energia — #{nome_do_mes_energia(@conta)}" %>

<div class="flex flex-wrap items-center justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-white">Energia</h1>
  </div>
  <%= render "navegacao_mes", conta: @conta %>
</div>

<% leituras = @leituras.values %>
<% consumo_kitnets = leituras.filter_map(&:consumo).sum %>
<% valor_kitnets = leituras.filter_map(&:valor).sum %>
<% valor_pago = leituras.select(&:pago?).filter_map(&:valor).sum %>

<%# conta do mês %>
<section class="card mt-6 p-5">
  <h2 class="text-sm font-medium text-slate-900 dark:text-white">Conta do mês</h2>

  <%= render "shared/error_summary", object: @conta %>

  <%= form_with(model: @conta, url: conta_energia_path(ano: @conta.ano, mes: @conta.mes), method: :patch, html: { autocomplete: "off" }, class: "mt-4",
                data: { controller: "tarifa" }) do |form| %>
    <div class="grid grid-cols-1 items-end gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <%= form.label :kwh_total, "Energia total (kWh)", class: label_classes %>
        <%= form.number_field :kwh_total, value: numero_para_campo(@conta.kwh_total), step: "any", min: 0, inputmode: "decimal", placeholder: "0",
              class: field_classes(@conta, :kwh_total), data: { tarifa_target: "kwh", action: "input->tarifa#calcular" } %>
      </div>
      <div>
        <%= form.label :valor_total, "Valor total (sem o desconto da solar)", class: label_classes %>
        <%= money_field form, :valor_total, data: { tarifa_target: "total", action: "input->money#format input->tarifa#calcular" } %>
      </div>
      <div>
        <p class="<%= label_classes %>">Valor do kWh</p>
        <p class="mt-1.5 rounded-lg bg-slate-50 px-3 py-2 text-sm font-medium tabular-nums text-slate-900 dark:bg-white/5 dark:text-white" data-tarifa-target="resultado">
          <%= @conta.valor_kwh ? number_to_currency(@conta.valor_kwh, precision: 4) : "—" %>
        </p>
      </div>
      <div>
        <%= form.submit "Salvar conta", class: "btn btn-primary w-full" %>
      </div>
    </div>
  <% end %>
</section>

<div class="mt-6 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
  <%= render "shared/stat_tile", label: "Consumo das kitnets", value: "#{kwh(consumo_kitnets)} kWh", icon_name: :bolt, tone: :primary, value_class: "text-xl",
        sublabel: (@conta.kwh_total ? "de #{kwh(@conta.kwh_total)} kWh da conta" : "lance a conta do mês") %>
  <%= render "shared/stat_tile", label: "Áreas comuns e perdas", value: (@conta.kwh_total ? "#{kwh(@conta.kwh_total - consumo_kitnets)} kWh" : "—"), icon_name: :building, tone: :info, value_class: "text-xl" %>
  <%= render "shared/stat_tile", label: "A cobrar das kitnets", value: number_to_currency(valor_kitnets), icon_name: :cash, tone: :primary, value_class: "text-xl",
        sublabel: (@conta.valor_total ? "de #{number_to_currency(@conta.valor_total)} da conta" : nil) %>
  <%= render "shared/stat_tile", label: "Já recebido", value: number_to_currency(valor_pago), icon_name: :check_circle, tone: :good, value_class: "text-xl",
        sublabel: "#{leituras.count(&:pago?)} de #{leituras.count { |l| l.valor.present? }} kitnets pagas" %>
</div>

<%# kitnets %>
<section class="card mt-6 overflow-hidden">
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 px-5 py-4 dark:border-white/5">
    <div>
      <h2 class="text-sm font-medium text-slate-900 dark:text-white">Por kitnet</h2>
    </div>
    <%= link_to editar_leituras_energia_path(ano: @conta.ano, mes: @conta.mes), class: "btn btn-primary" do %>
      <%= icon :pencil, css_class: "size-4" %> Lançar leituras
    <% end %>
  </div>

  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-slate-100 dark:divide-white/5">
      <thead class="bg-slate-50/70 dark:bg-white/[0.03]">
        <tr>
          <%# no celular ficam Kitnet, Valor (com a situação embaixo) e os botões %>
          <% [ [ "Kitnet", "left", true ], [ "Leitura anterior", "right", false ], [ "Leitura atual", "right", false ], [ "Consumo", "right", false ], [ "Valor", "right", true ], [ "Pagamento", "left", false ] ].each do |titulo, lado, celular| %>
            <th class="<%= "hidden sm:table-cell" unless celular %> px-3 py-3 sm:px-4 max-[359px]:px-2 text-<%= lado %> text-[11px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400"><%= titulo %></th>
          <% end %>
          <th class="hidden sm:table-cell px-3 py-3 sm:px-4 max-[359px]:px-2"><span class="sr-only">Ações</span></th>
          <th class="px-2 py-3 sm:px-4"><span class="sr-only">Mensagem</span></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 dark:divide-white/5">
        <% @unidades.each do |unidade| %>
          <% leitura = @leituras[unidade.id] %>
          <tr>
            <td class="whitespace-nowrap px-3 py-3 sm:px-4 max-[359px]:px-2 text-sm font-medium text-slate-900 dark:text-white"><%= unidade.nome %></td>
            <td class="hidden sm:table-cell whitespace-nowrap px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-sm tabular-nums text-slate-500 dark:text-slate-400"><%= kwh(leitura&.leitura_anterior) %></td>
            <td class="hidden sm:table-cell whitespace-nowrap px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-sm tabular-nums text-slate-500 dark:text-slate-400"><%= kwh(leitura&.leitura_atual) %></td>
            <td class="hidden sm:table-cell whitespace-nowrap px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-sm tabular-nums text-slate-900 dark:text-white"><%= leitura&.consumo ? "#{kwh(leitura.consumo)} kWh" : "—" %></td>
            <td class="whitespace-nowrap px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-sm font-medium tabular-nums text-slate-900 dark:text-white">
              <%= leitura&.valor ? number_to_currency(leitura.valor) : "—" %>
              <% if leitura&.pago? %>
                <span class="block text-xs font-normal text-emerald-700 sm:hidden dark:text-emerald-400">✓ <%= l(leitura.data_pagamento, format: "%d/%m") %></span>
              <% elsif leitura&.valor %>
                <span class="block text-xs font-normal text-amber-700 sm:hidden dark:text-amber-400">em aberto</span>
              <% end %>
            </td>
            <td class="hidden sm:table-cell whitespace-nowrap px-3 py-3 sm:px-4 max-[359px]:px-2 text-sm">
              <% if leitura&.pago? %>
                <%= status_badge("Pago em #{l(leitura.data_pagamento, format: "%d/%m/%Y")}", tone: :good, icon: :check_circle) %>
              <% elsif leitura&.valor %>
                <%= status_badge("Em aberto", tone: :warning, icon: :clock) %>
              <% else %>
                <span class="text-slate-400 dark:text-slate-500">—</span>
              <% end %>
            </td>
            <td class="hidden sm:table-cell whitespace-nowrap px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-sm">
              <% if leitura&.valor && !leitura.pago? %>
                <%= button_to pagar_leitura_energia_path(leitura), method: :patch, form_class: "inline-block", class: "inline-flex cursor-pointer items-center gap-1 rounded-md px-2 py-1 text-xs font-medium text-emerald-700 hover:bg-emerald-50 dark:text-emerald-400 dark:hover:bg-emerald-400/10", data: { turbo_confirm: "Marcar a energia da kitnet #{unidade.nome} como paga hoje?" } do %>
                  <%= icon :check_circle, css_class: "size-4" %> Pago
                <% end %>
              <% elsif leitura&.pago? %>
                <%= button_to desfazer_pagamento_leitura_energia_path(leitura), method: :patch, form_class: "inline-block", class: "inline-flex cursor-pointer items-center gap-1 rounded-md px-2 py-1 text-xs font-medium text-slate-500 hover:bg-slate-100 hover:text-slate-700 dark:text-slate-400 dark:hover:bg-white/5 dark:hover:text-slate-200", title: "Desfazer o pagamento", data: { turbo_confirm: "Desfazer o pagamento da energia da kitnet #{unidade.nome} (pago em #{l(leitura.data_pagamento)})? Ela volta para em aberto." } do %>
                  <%= icon :desfazer, css_class: "size-4" %> Desfazer
                <% end %>
              <% end %>
            </td>
            <td class="whitespace-nowrap px-2 py-3 sm:px-4 text-right">
              <% if leitura&.valor && !leitura.pago? %>
                <%= button_to pagar_leitura_energia_path(leitura), method: :patch, form_class: "inline-block sm:hidden", class: "inline-flex cursor-pointer items-center gap-1 rounded-lg px-2 py-1.5 text-xs font-semibold text-emerald-700 hover:bg-emerald-50 dark:text-emerald-400", data: { turbo_confirm: "Marcar a energia da kitnet #{unidade.nome} como paga hoje?" } do %><%= icon :check_circle, css_class: "size-4" %> Pago<% end %>
              <% elsif leitura&.pago? %>
                <%= button_to desfazer_pagamento_leitura_energia_path(leitura), method: :patch, form_class: "inline-block sm:hidden", class: "inline-flex cursor-pointer items-center rounded-lg p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-600 dark:hover:bg-white/5", title: "Desfazer o pagamento", aria: { label: "Desfazer o pagamento da kitnet #{unidade.nome}" }, data: { turbo_confirm: "Desfazer o pagamento da energia da kitnet #{unidade.nome} (pago em #{l(leitura.data_pagamento)})? Ela volta para em aberto." } do %><%= icon :desfazer, css_class: "size-4" %><% end %>
              <% end %>
              <% if leitura&.valor %>
                <% contrato = @contratos[unidade.id] %>
                <%= link_to whatsapp_url(contrato&.celular, mensagem_energia(leitura, contrato)), target: "_blank", rel: "noopener", data: { turbo: false },
                      title: contrato ? "Mandar a conta para #{contrato.inquilino}#{" (#{contrato.celular_formatado})" if contrato.celular}" : "Mandar a conta pelo WhatsApp (sem contrato ativo)",
                      class: "inline-flex items-center gap-1 rounded-lg px-2 py-1.5 text-xs font-semibold #{contrato&.celular ? "text-emerald-700 hover:bg-emerald-50 dark:text-emerald-400 dark:hover:bg-emerald-400/10" : "text-slate-500 hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-white/5"}" do %>
                  <%= icon :chat, css_class: "size-4" %><span class="hidden lg:inline">WhatsApp</span>
                <% end %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
      <tfoot class="bg-slate-50 dark:bg-white/5">
        <tr>
          <td class="px-3 py-3 sm:px-4 max-[359px]:px-2 text-sm font-semibold text-slate-900 dark:text-white">Total</td>
          <td class="hidden sm:table-cell "></td>
          <td class="hidden sm:table-cell "></td>
          <td class="hidden sm:table-cell whitespace-nowrap px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-sm font-semibold tabular-nums text-slate-900 dark:text-white"><%= kwh(consumo_kitnets) %> kWh</td>
          <td class="whitespace-nowrap px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-sm font-semibold tabular-nums text-slate-900 dark:text-white"><%= number_to_currency(valor_kitnets) %></td>
          <td class="hidden sm:table-cell"></td>
          <td class="hidden sm:table-cell"></td>
          <td></td>
        </tr>
      </tfoot>
    </table>
  </div>
</section>

<%# mês a mês %>
<% linhas = (1..12).map do |mes|
     c = @contas_do_ano[mes]
     ls = c ? c.leituras.to_a : []
     { mes: mes, conta: c, consumo: ls.filter_map(&:consumo).sum, cobrar: ls.filter_map(&:valor).sum, recebido: ls.select(&:pago?).filter_map(&:valor).sum }
   end %>
<section class="card mt-6 overflow-hidden">
  <div class="border-b border-slate-100 px-5 py-4 dark:border-white/5">
    <h2 class="text-sm font-medium text-slate-900 dark:text-white">Mês a mês em <%= @conta.ano %></h2>
  </div>
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-slate-100 dark:divide-white/5">
      <thead class="bg-slate-50/70 dark:bg-white/[0.03]">
        <tr>
          <% [ [ "Mês", "left", true ], [ "kWh da conta", "right", false ], [ "Valor do kWh", "right", false ], [ "Valor da conta", "right", true ], [ "Consumo das kitnets", "right", false ], [ "A cobrar das kitnets", "right", true ], [ "Já recebido", "right", false ] ].each do |titulo, lado, celular| %>
            <th class="<%= "hidden sm:table-cell" unless celular %> px-3 py-3 sm:px-4 max-[359px]:px-2 text-<%= lado %> text-[11px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400"><%= titulo %></th>
          <% end %>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 dark:divide-white/5">
        <% linhas.each do |l| %>
          <% c = l[:conta] %>
          <tr class="cursor-pointer hover:bg-slate-50 dark:hover:bg-white/5 <%= "bg-indigo-50/60 dark:bg-indigo-400/5" if l[:mes] == @conta.mes %>"
              data-controller="row-link" data-row-link-url-value="<%= energia_path(ano: @conta.ano, mes: l[:mes]) %>" data-action="click->row-link#visit">
            <td class="whitespace-nowrap px-3 py-3 sm:px-4 max-[359px]:px-2 text-sm font-medium text-slate-900 dark:text-white"><%= t("date.month_names")[l[:mes]].capitalize %></td>
            <td class="hidden sm:table-cell whitespace-nowrap px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-sm tabular-nums text-slate-500 dark:text-slate-400"><%= c&.kwh_total ? "#{kwh(c.kwh_total)} kWh" : "—" %></td>
            <td class="hidden sm:table-cell whitespace-nowrap px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-sm tabular-nums text-slate-500 dark:text-slate-400"><%= c&.valor_kwh ? number_to_currency(c.valor_kwh, precision: 4) : "—" %></td>
            <td class="whitespace-nowrap px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-sm tabular-nums text-slate-900 dark:text-white"><%= c&.valor_total ? number_to_currency(c.valor_total) : "—" %></td>
            <td class="hidden sm:table-cell whitespace-nowrap px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-sm tabular-nums text-slate-500 dark:text-slate-400"><%= l[:consumo].positive? ? "#{kwh(l[:consumo])} kWh" : "—" %></td>
            <td class="whitespace-nowrap px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-sm font-medium tabular-nums text-slate-900 dark:text-white"><%= l[:cobrar].positive? ? number_to_currency(l[:cobrar]) : "—" %></td>
            <td class="hidden sm:table-cell whitespace-nowrap px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-sm tabular-nums text-slate-500 dark:text-slate-400"><%= l[:recebido].positive? ? number_to_currency(l[:recebido]) : "—" %></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot class="bg-slate-50 dark:bg-white/5">
        <tr>
          <td class="px-3 py-3 sm:px-4 max-[359px]:px-2 text-sm font-semibold text-slate-900 dark:text-white">Total <%= @conta.ano %></td>
          <td class="hidden sm:table-cell whitespace-nowrap px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-sm font-semibold tabular-nums text-slate-900 dark:text-white"><%= kwh(linhas.sum { |l| l[:conta]&.kwh_total.to_d }) %> kWh</td>
          <td class="hidden sm:table-cell"></td>
          <td class="whitespace-nowrap px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-sm font-semibold tabular-nums text-slate-900 dark:text-white"><%= number_to_currency(linhas.sum { |l| l[:conta]&.valor_total.to_d }) %></td>
          <td class="hidden sm:table-cell whitespace-nowrap px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-sm font-semibold tabular-nums text-slate-900 dark:text-white"><%= kwh(linhas.sum { |l| l[:consumo] }) %> kWh</td>
          <td class="whitespace-nowrap px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-sm font-semibold tabular-nums text-slate-900 dark:text-white"><%= number_to_currency(linhas.sum { |l| l[:cobrar] }) %></td>
          <td class="hidden sm:table-cell whitespace-nowrap px-3 py-3 sm:px-4 max-[359px]:px-2 text-right text-sm font-semibold tabular-nums text-slate-900 dark:text-white"><%= number_to_currency(linhas.sum { |l| l[:recebido] }) %></td>
        </tr>
      </tfoot>
    </table>
  </div>
</section>
