<% content_for :title, "Leituras de energia — #{nome_do_mes_energia(@conta)}" %>

<%= link_to energia_path(ano: @conta.ano, mes: @conta.mes), class: "inline-flex items-center gap-1 text-sm font-medium text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-white" do %>
  <%= icon :arrow_left, css_class: "size-4" %> Energia de <%= nome_do_mes_energia(@conta).downcase %>
<% end %>

<h1 class="mt-3 text-2xl font-semibold text-slate-900 dark:text-white">Leituras — <%= nome_do_mes_energia(@conta) %></h1>

<% com_erro = @leituras.values.select { |l| l.errors.any? } %>
<% if com_erro.any? %>
  <div class="mt-6 rounded-lg bg-rose-50 px-4 py-3 text-sm text-rose-700 ring-1 ring-inset ring-rose-600/20 dark:bg-rose-400/10 dark:text-rose-400 dark:ring-rose-400/20">
    <p class="font-medium">Corrija as leituras antes de salvar:</p>
    <ul class="mt-1 list-disc pl-5">
      <% com_erro.each do |leitura| %>
        <% leitura.errors.full_messages.each do |msg| %>
          <li>Kitnet <%= leitura.unidade.nome %>: <%= msg %></li>
        <% end %>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with(url: leituras_energia_path(ano: @conta.ano, mes: @conta.mes), method: :patch, html: { autocomplete: "off" }, class: "mt-6") do |form| %>
  <div class="overflow-hidden rounded-xl border border-slate-200 bg-white dark:border-white/10 dark:bg-slate-800/40">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200 dark:divide-white/10">
        <thead class="bg-slate-50 dark:bg-white/5">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">Kitnet</th>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">Leitura anterior (kWh)</th>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">Leitura atual (kWh)</th>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">Pago em</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-white/5">
          <% @unidades.each do |unidade| %>
            <% leitura = @leituras[unidade.id] %>
            <% nome = "leituras[#{unidade.id}]" %>
            <tr>
              <td class="whitespace-nowrap px-4 py-2 text-sm font-medium text-slate-900 dark:text-white"><%= unidade.nome %></td>
              <td class="px-4 py-2"><%= number_field_tag "#{nome}[leitura_anterior]", numero_para_campo(leitura.leitura_anterior), step: "any", min: 0, inputmode: "decimal", class: "#{field_classes(leitura, :leitura_anterior)} mt-0 min-w-28", aria: { label: "Leitura anterior da kitnet #{unidade.nome}" } %></td>
              <td class="px-4 py-2"><%= number_field_tag "#{nome}[leitura_atual]", numero_para_campo(leitura.leitura_atual), step: "any", min: 0, inputmode: "decimal", class: "#{field_classes(leitura, :leitura_atual)} mt-0 min-w-28", aria: { label: "Leitura atual da kitnet #{unidade.nome}" } %></td>
              <td class="px-4 py-2"><%= date_field_tag "#{nome}[data_pagamento]", leitura.data_pagamento, max: Date.current, class: "#{field_classes(leitura, :data_pagamento)} mt-0 min-w-36", aria: { label: "Data do pagamento da kitnet #{unidade.nome}" } %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="mt-6 flex items-center justify-end gap-3">
    <%= link_to "Cancelar", energia_path(ano: @conta.ano, mes: @conta.mes), class: "rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 dark:border-white/10 dark:text-slate-200 dark:hover:bg-white/5" %>
    <%= form.submit "Salvar leituras", class: "cursor-pointer rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500" %>
  </div>
<% end %>
