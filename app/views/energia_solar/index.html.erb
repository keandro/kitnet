<% a = @apuracao %>
<% content_for :title, "Energia solar — #{nome_do_mes_energia(a)}" %>

<div class="flex flex-wrap items-center justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-white">Energia solar</h1>
  </div>
  <%= render "energia/navegacao_mes", conta: a, rota: :energia_solar_path %>
</div>

<%= render "shared/error_summary", object: a %>

<%= form_with(model: a, url: apuracao_energia_solar_path(ano: a.ano, mes: a.mes), method: :patch, html: { autocomplete: "off" }, class: "mt-6") do |form| %>
  <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
    <%# 1. valor sem solar %>
    <section class="card p-5">
      <h2 class="text-sm font-medium text-slate-900 dark:text-white">Sem a energia solar</h2>

      <dl class="mt-4 space-y-4">
        <div>
          <dt class="<%= label_classes %>">Kitnets (conta inteira)</dt>
          <dd class="mt-1 rounded-lg bg-slate-50 px-3 py-2 text-sm tabular-nums text-slate-900 dark:bg-white/5 dark:text-white">
            <% if a.valor_kitnets %>
              <%= number_to_currency(a.valor_kitnets) %>
              <span class="text-xs text-slate-500 dark:text-slate-400">· <%= kwh(a.conta_energia.kwh_total) %> kWh × <%= number_to_currency(a.conta_energia.valor_kwh, precision: 3) %></span>
            <% else %>
              <span class="text-slate-500 dark:text-slate-400">Lance a conta em</span>
              <%= link_to "Energia", energia_path(ano: a.ano, mes: a.mes), class: "font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400" %>
            <% end %>
          </dd>
        </div>
        <div>
          <%= form.label :valor_apartamento, class: label_classes %>
          <%= money_field form, :valor_apartamento %>
        </div>
        <div class="flex items-center justify-between border-t border-slate-200 pt-3 text-sm dark:border-white/10">
          <span class="text-slate-500 dark:text-slate-400">Total sem solar</span>
          <span class="font-semibold tabular-nums text-slate-900 dark:text-white"><%= a.valor_sem_solar ? number_to_currency(a.valor_sem_solar) : "—" %></span>
        </div>
      </dl>
    </section>

    <%# 2. pago %>
    <section class="card p-5">
      <h2 class="text-sm font-medium text-slate-900 dark:text-white">Pago de verdade</h2>

      <div class="mt-4 space-y-4">
        <div>
          <%= form.label :pago_kitnets, class: label_classes %>
          <%= money_field form, :pago_kitnets %>
        </div>
        <div>
          <%= form.label :pago_apartamento, class: label_classes %>
          <%= money_field form, :pago_apartamento %>
        </div>
        <div class="flex items-center justify-between border-t border-slate-200 pt-3 text-sm dark:border-white/10">
          <span class="text-slate-500 dark:text-slate-400">Total pago</span>
          <span class="font-semibold tabular-nums text-slate-900 dark:text-white"><%= a.total_pago ? number_to_currency(a.total_pago) : "—" %></span>
        </div>
      </div>
    </section>

    <%# 3. lucro %>
    <section class="card flex flex-col p-5">
      <h2 class="text-sm font-medium text-slate-900 dark:text-white">Lucro das kitnets</h2>

      <p class="mt-4 text-4xl font-semibold tabular-nums <%= a.lucro_kitnets&.negative? ? "text-rose-700 dark:text-rose-400" : "text-slate-900 dark:text-white" %>">
        <%= a.lucro_kitnets ? number_to_currency(a.lucro_kitnets) : "—" %>
      </p>
      <p class="mt-1 text-sm tabular-nums text-slate-500 dark:text-slate-400">
        <%= a.lucro_kitnets ? "#{number_to_currency(a.valor_kitnets)} − #{number_to_currency(a.pago_kitnets)}" : "Preencha a conta paga das kitnets." %>
      </p>

      <div class="mt-5 border-t border-slate-200 pt-4 dark:border-white/10">
        <h3 class="text-sm font-medium text-slate-900 dark:text-white">Lucro total</h3>
        <p class="mt-2 text-2xl font-semibold tabular-nums <%= a.lucro&.negative? ? "text-rose-700 dark:text-rose-400" : "text-slate-900 dark:text-white" %>">
          <%= a.lucro ? number_to_currency(a.lucro) : "—" %>
        </p>
        <% if a.lucro %>
          <p class="mt-1 text-sm tabular-nums text-slate-500 dark:text-slate-400"><%= number_to_currency(a.valor_sem_solar) %> − <%= number_to_currency(a.total_pago) %></p>
        <% end %>
      </div>

      <div class="mt-auto pt-6">
        <%= form.submit "Salvar", class: "btn btn-primary w-full" %>
      </div>
    </section>
  </div>
<% end %>

<%= render "energia_solar/lucro_mes_a_mes", ano: a.ano, lucros: @lucros, lucros_kitnets: @lucros_kitnets, destaque: a.mes %>
