<% nome_mes = "#{t("date.month_names")[@fechamento.mes].capitalize} de #{@fechamento.ano}" %>
<% content_for :title, "Finanças — #{nome_mes}" %>

<%= link_to financas_path(ano: @fechamento.ano), class: "inline-flex items-center gap-1 text-sm font-medium text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-white" do %>
  <%= icon :arrow_left, css_class: "size-4" %> Finanças de <%= @fechamento.ano %>
<% end %>

<h1 class="mt-3 text-2xl font-semibold tracking-tight text-slate-900 dark:text-white"><%= nome_mes %></h1>

<div class="card mt-6 max-w-2xl p-6">
  <%= render "shared/error_summary", object: @fechamento %>

  <%= form_with(model: @fechamento, url: fechamento_mensal_path(ano: @fechamento.ano, mes: @fechamento.mes), method: :patch, html: { autocomplete: "off" }) do |form| %>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      <div>
        <%= form.label :despesas_gerais, class: label_classes %>
        <%= money_field form, :despesas_gerais %>
      </div>

      <div>
        <%= form.label :agua_esgoto, class: label_classes %>
        <%= money_field form, :agua_esgoto %>
      </div>

      <div class="sm:col-span-2">
        <% lucro_solar = EnergiaSolarMensal.lucros_do_ano(@fechamento.ano, tipo: :lucro_kitnets)[@fechamento.mes] %>
        <p class="<%= label_classes %>">Energia solar</p>
        <p class="mt-1 rounded-lg border border-dashed border-slate-300 px-3 py-2 text-sm text-slate-500 dark:border-white/10 dark:text-slate-400">
          <%= lucro_solar ? "Lucro das kitnets de #{number_to_currency(lucro_solar)}, somado ao resultado." : "Ainda não apurada para este mês." %>
          <%= link_to "Abrir energia solar", energia_solar_path(ano: @fechamento.ano, mes: @fechamento.mes), class: "font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400" %>
        </p>
      </div>
    </div>

    <div class="mt-6 flex items-center justify-end gap-3 border-t border-slate-100 pt-5 dark:border-white/5">
      <%= link_to "Cancelar", financas_path(ano: @fechamento.ano), class: "btn btn-secondary" %>
      <%= form.submit "Salvar", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
