<% content_for :title, "Pessoas" %>

<div class="flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-semibold text-slate-900 dark:text-white">Pessoas</h1>
    <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Moradores e fiadores cadastrados.</p>
  </div>
  <%= link_to new_pessoa_path, class: "inline-flex items-center gap-1.5 rounded-lg bg-indigo-600 px-3.5 py-2 text-sm font-medium text-white hover:bg-indigo-500" do %>
    <%= icon :plus, css_class: "size-4" %> Nova pessoa
  <% end %>
</div>

<div class="mt-6 overflow-hidden rounded-xl border border-slate-200 bg-white dark:border-white/10 dark:bg-slate-800/40">
  <% if @pessoas.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200 dark:divide-white/10">
        <thead class="bg-slate-50 dark:bg-white/5">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">Nome</th>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">CPF</th>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">Telefone</th>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">Categoria</th>
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-white/5">
          <%= render partial: "pessoa_row", collection: @pessoas, as: :pessoa %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="px-4 py-12 text-center">
      <%= icon :users, css_class: "mx-auto size-8 text-slate-300 dark:text-slate-600" %>
      <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">Nenhuma pessoa cadastrada ainda.</p>
    </div>
  <% end %>
</div>
