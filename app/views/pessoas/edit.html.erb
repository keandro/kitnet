<% content_for :title, "Editar pessoa" %>

<%= link_to @pessoa, class: "inline-flex items-center gap-1 text-sm font-medium text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-white" do %>
  <%= icon :arrow_left, css_class: "size-4" %> <%= @pessoa.nome %>
<% end %>

<h1 class="mt-3 text-2xl font-semibold text-slate-900 dark:text-white">Editar pessoa</h1>

<div class="mt-6">
  <%= render "form", pessoa: @pessoa %>
</div>
