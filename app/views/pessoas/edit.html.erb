<% content_for :title, "Editar pessoa" %>

<div class="md:w-2/3 w-full">
  <h1 class="font-bold text-4xl">Editar pessoa</h1>

  <%= render "form", pessoa: @pessoa %>

  <%= link_to "Ver esta pessoa", @pessoa, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  <%= link_to "Voltar para pessoas", pessoas_path, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
</div>
