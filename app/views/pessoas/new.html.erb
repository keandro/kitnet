<% content_for :title, "Nova pessoa" %>

<%= link_to pessoas_path, class: "inline-flex items-center gap-1 text-sm font-medium text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-white" do %>
  <%= icon :arrow_left, css_class: "size-4" %> Pessoas
<% end %>

<h1 class="mt-3 text-2xl font-semibold text-slate-900 dark:text-white">Nova pessoa</h1>
<p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Cadastre um morador ou fiador.</p>

<div class="mt-6">
  <%= render "form", pessoa: @pessoa %>
</div>
