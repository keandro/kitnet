<div class="rounded-xl border border-slate-200 bg-white p-6 dark:border-white/10 dark:bg-slate-800/40">
  <%= render "shared/error_summary", object: pessoa %>

  <%= form_with(model: pessoa, html: { autocomplete: "off" }) do |form| %>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      <div class="sm:col-span-2">
        <%= form.label :nome, class: label_classes %>
        <%= form.text_field :nome, class: field_classes(pessoa, :nome) %>
      </div>

      <div>
        <%= form.label :cpf, class: label_classes %>
        <%= form.text_field :cpf, class: field_classes(pessoa, :cpf) %>
      </div>

      <div>
        <%= form.label :telefone, class: label_classes %>
        <%= form.text_field :telefone, class: field_classes(pessoa, :telefone) %>
      </div>

      <div>
        <%= form.label :email, class: label_classes %>
        <%= form.email_field :email, class: field_classes(pessoa, :email) %>
      </div>

      <div>
        <%= form.label :endereco, class: label_classes %>
        <%= form.text_field :endereco, class: field_classes(pessoa, :endereco) %>
      </div>
    </div>

    <div class="mt-6 flex items-center justify-end gap-3 border-t border-slate-200 pt-5 dark:border-white/10">
      <%= link_to "Cancelar", pessoas_path, class: "rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 dark:border-white/10 dark:text-slate-200 dark:hover:bg-white/5" %>
      <%= form.submit "Salvar", class: "cursor-pointer rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500" %>
    </div>
  <% end %>
</div>
