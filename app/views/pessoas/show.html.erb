<% content_for :title, "#{@pessoa.nome} — Pessoa" %>

<%= link_to pessoas_path, class: "inline-flex items-center gap-1 text-sm font-medium text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-white" do %>
  <%= icon :arrow_left, css_class: "size-4" %> Pessoas
<% end %>

<div class="mt-4 flex items-center justify-end gap-2">
  <%= link_to edit_pessoa_path(@pessoa), class: "inline-flex items-center gap-1.5 rounded-lg border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 dark:border-white/10 dark:text-slate-200 dark:hover:bg-white/5" do %>
    <%= icon :pencil, css_class: "size-4" %> Editar
  <% end %>
  <%= button_to @pessoa, method: :delete, form_class: "inline-block", class: "inline-flex items-center gap-1.5 rounded-lg border border-rose-200 px-3 py-2 text-sm font-medium text-rose-600 hover:bg-rose-50 dark:border-rose-400/20 dark:text-rose-400 dark:hover:bg-rose-400/10 cursor-pointer", data: { turbo_confirm: "Tem certeza?" } do %>
    <%= icon :trash, css_class: "size-4" %> Remover
  <% end %>
</div>

<div class="mt-4">
  <%= render @pessoa %>
</div>
