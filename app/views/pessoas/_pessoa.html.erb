<div id="<%= dom_id pessoa %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Nome:</strong>
    <%= pessoa.nome %>
  </div>
  <div>
    <strong class="block font-medium mb-1">CPF:</strong>
    <%= pessoa.cpf %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Telefone:</strong>
    <%= pessoa.telefone %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Email:</strong>
    <%= pessoa.email %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Endereço:</strong>
    <%= pessoa.endereco %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Categoria:</strong>
    <%= t("pessoa.categoria.#{pessoa.categoria}") %>
  </div>
</div>
